{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoryProject",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "channel_id",
    "name",
    "history_context",
    "created_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "history_context": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    }
  }
}
