{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/channel_voice_profile.schema.json",
  "title": "Channel Voice Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "voice_id",
    "voice_kind",
    "default_preset",
    "calibration"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider": {
      "const": "elevenlabs"
    },
    "voice_id": {
      "type": "string",
      "minLength": 1
    },
    "voice_kind": {
      "const": "professional"
    },
    "default_preset": {
      "type": "string",
      "enum": [
        "economy",
        "quality_cloned_voice"
      ]
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economy",
        "quality_cloned_voice"
      ],
      "properties": {
        "economy": {
          "$ref": "#/$defs/calibration"
        },
        "quality_cloned_voice": {
          "$ref": "#/$defs/calibration"
        }
      }
    }
  },
  "$defs": {
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stability",
        "similarity_boost",
        "use_speaker_boost"
      ],
      "properties": {
        "stability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "similarity_boost": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "use_speaker_boost": {
          "type": "boolean"
        }
      }
    }
  }
}
