{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/media_provider_settings.schema.json",
  "title": "Media Provider Settings V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "enabled",
    "base_url",
    "api_key_configured",
    "default_image_model",
    "default_image_aspect_ratio",
    "default_upscale",
    "poll_interval_seconds",
    "max_parallel_tasks",
    "enabled_media_kinds"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "glabs_webhook"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "base_url": {
      "type": "string",
      "minLength": 1
    },
    "api_key_configured": {
      "type": "boolean"
    },
    "api_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Write-only in API requests. Never returned by GET."
    },
    "default_image_model": {
      "type": "string",
      "enum": [
        "nano_banana_2",
        "nano_banana_pro"
      ]
    },
    "default_image_aspect_ratio": {
      "type": "string",
      "enum": [
        "1:1",
        "3:4",
        "4:3",
        "9:16",
        "16:9"
      ]
    },
    "default_upscale": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "const": "2K"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "const": "4K"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 2,
          "prefixItems": [
            {
              "const": "2K"
            },
            {
              "const": "4K"
            }
          ],
          "items": false
        }
      ]
    },
    "poll_interval_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "max_parallel_tasks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "enabled_media_kinds": {
      "type": "array",
      "prefixItems": [
        {
          "const": "image"
        }
      ],
      "items": false
    }
  }
}
