{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/channel_dna.schema.json",
  "title": "Channel DNA V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "narration_wpm",
    "pacing_profiles",
    "narration_identity",
    "visual_identity",
    "entity_styles",
    "global_negative_constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "language",
        "niche",
        "audience"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "niche": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "narration_wpm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 80,
          "maximum": 300
        },
        "max": {
          "type": "integer",
          "minimum": 80,
          "maximum": 300
        }
      },
      "description": "Channel-owned narration WPM range. Script & Analysis builds inherit this range and the LLM chooses one exact planned_narration_wpm per section within it."
    },
    "pacing_profiles": {
      "$ref": "#/$defs/pacing_profiles"
    },
    "narration_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "delivery",
        "explanation_style",
        "tone_boundaries",
        "avoid"
      ],
      "properties": {
        "voice": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "delivery": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "explanation_style": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "tone_boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        }
      }
    },
    "visual_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "medium",
        "linework",
        "rendering",
        "palette",
        "shape_language",
        "texture",
        "editorial_language"
      ],
      "properties": {
        "medium": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "linework": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "rendering": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "shape_language": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "texture": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        },
        "editorial_language": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true,
          "description": "Channel-owned editorial visual communication grammar: how locked meaning may switch representation mode, compress ideas, use text/reaction, and create memorable visual attitude without adding factual meaning.",
          "minItems": 1
        }
      }
    },
    "entity_styles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "location",
        "prop",
        "recurring_visual_subject"
      ],
      "properties": {
        "character": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appearance",
            "avoid"
          ],
          "properties": {
            "appearance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appearance",
            "avoid"
          ],
          "properties": {
            "appearance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            }
          }
        },
        "prop": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appearance",
            "avoid"
          ],
          "properties": {
            "appearance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            }
          }
        },
        "recurring_visual_subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appearance",
            "avoid"
          ],
          "properties": {
            "appearance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "global_negative_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": ".*\\S.*"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "pacing_hold_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "pacing_density_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred_hold_seconds"
      ],
      "properties": {
        "preferred_hold_seconds": {
          "$ref": "#/$defs/pacing_hold_range"
        }
      }
    },
    "pacing_mode_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "high": {
          "$ref": "#/$defs/pacing_density_profile"
        },
        "medium": {
          "$ref": "#/$defs/pacing_density_profile"
        },
        "low": {
          "$ref": "#/$defs/pacing_density_profile"
        }
      }
    },
    "pacing_profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fast",
        "medium",
        "slow"
      ],
      "description": "Channel-owned numeric calibration for the three per-video pacing modes. Projects snapshot these exact profiles; runtime code must not substitute global numeric defaults.",
      "properties": {
        "fast": {
          "$ref": "#/$defs/pacing_mode_profile"
        },
        "medium": {
          "$ref": "#/$defs/pacing_mode_profile"
        },
        "slow": {
          "$ref": "#/$defs/pacing_mode_profile"
        }
      }
    }
  }
}
