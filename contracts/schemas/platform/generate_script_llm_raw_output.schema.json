{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/generate_script_llm_raw_output.schema.json",
  "title": "Generate Script LLM Raw Output V4",
  "description": "Raw Script creative output. The task input supplies an allowed narration WPM range; the LLM must choose an exact planned_narration_wpm for every section within that range. Return only the raw Script fields defined here; do not include section IDs, source tracking, full_script, word-count metadata, aggregate planned_average_wpm, or pre-TTS runtime diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "hook",
    "script_sections"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hook": {
      "type": "string",
      "minLength": 1
    },
    "script_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/raw_script_section"
      }
    }
  },
  "$defs": {
    "raw_script_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_title",
        "section_role",
        "planned_narration_wpm",
        "narration",
        "spoken_overrides",
        "delivery_cues"
      ],
      "properties": {
        "section_title": {
          "type": "string",
          "minLength": 1
        },
        "section_role": {
          "type": "string",
          "minLength": 1
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "spoken_overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spoken_override_external"
          },
          "description": "Required, may be empty. Exact authored text replacements for spoken narration. Do not return resolved offsets or IDs; they are outside this raw output field."
        },
        "delivery_cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivery_cue_external"
          },
          "description": "Required, may be empty. Sparse delivery cues. Do not return resolved offsets or IDs; they are outside this raw output field."
        },
        "planned_narration_wpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 300,
          "description": "Exact section narration WPM chosen by the LLM within the supplied user_input.narration_wpm range."
        }
      }
    },
    "spoken_override_external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_quote",
        "context_quote",
        "spoken_text"
      ],
      "properties": {
        "anchor_quote": {
          "type": "string",
          "minLength": 1
        },
        "context_quote": {
          "type": "string",
          "minLength": 1
        },
        "spoken_text": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[<>]"
          },
          "description": "Plain spoken text only. SSML/provider markup is forbidden."
        }
      }
    },
    "delivery_cue_external": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_quote",
        "context_quote",
        "kind",
        "pause_strength"
      ],
      "properties": {
        "anchor_quote": {
          "type": "string",
          "minLength": 1
        },
        "context_quote": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "pause_after"
        },
        "pause_strength": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "long"
          ]
        }
      }
    }
  }
}
