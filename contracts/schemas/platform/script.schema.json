{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/script.schema.json",
  "title": "Script V3",
  "description": "Normalized script artifact schema (schema_version 1.0). This is the persisted artifact shape after backend normalization. source_topic_ideas_artifact_id and section_id values are assigned by the backend, not the LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "channel_context",
    "source_topic_ideas_artifact_id",
    "source_topic_idea",
    "source_user_input",
    "video_pacing_profile",
    "planned_average_wpm",
    "computed_constraints",
    "title",
    "hook",
    "script_sections",
    "full_script",
    "section_word_counts",
    "word_count",
    "runtime_diagnostics"
  ],
  "properties": {
    "artifact_type": {
      "const": "script"
    },
    "schema_version": {
      "const": "1.0"
    },
    "channel_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "source_topic_ideas_artifact_id": {
      "type": "string",
      "minLength": 1,
      "description": "Backend-assigned: artifact_id of the Topic Ideas artifact from which the selected idea was loaded. Never set by the LLM or client."
    },
    "source_topic_idea": {
      "$ref": "#/$defs/script_topic_idea"
    },
    "source_user_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_duration_minutes",
        "pov_style",
        "avoid",
        "section_count_mode",
        "pacing_mode",
        "narration_wpm"
      ],
      "properties": {
        "target_duration_minutes": {
          "type": "number",
          "minimum": 1
        },
        "pov_style": {
          "type": "string"
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_count_mode": {
          "type": "string",
          "enum": [
            "llm_decides",
            "backend_plan"
          ],
          "description": "Section planning mode used to author this Script."
        },
        "pacing_mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ],
          "description": "Per-video pacing mode selected when this Script prompt was built."
        },
        "narration_wpm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 80,
              "maximum": 300
            },
            "max": {
              "type": "integer",
              "minimum": 80,
              "maximum": 300
            }
          },
          "description": "Inclusive narration WPM range selected when this Script prompt was built."
        }
      }
    },
    "planned_average_wpm": {
      "type": "integer",
      "minimum": 80,
      "maximum": 300,
      "description": "Backend-derived whole-video aggregate narration pace computed from the section-specific planned_narration_wpm values."
    },
    "computed_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_planned_average_wpm",
        "planned_narration_wpm_range",
        "section_count_mode",
        "recommended_section_count",
        "minimum_section_count",
        "maximum_section_count"
      ],
      "properties": {
        "section_count_mode": {
          "type": "string",
          "enum": [
            "llm_decides",
            "backend_plan"
          ]
        },
        "recommended_section_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "minimum_section_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "maximum_section_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "derived_planned_average_wpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 300,
          "description": "Backend-derived aggregate planned narration pace from normalized section timing."
        },
        "planned_narration_wpm_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 80,
              "maximum": 300
            },
            "max": {
              "type": "integer",
              "minimum": 80,
              "maximum": 300
            }
          },
          "description": "Exact inclusive WPM range that constrained section-level authoring for this Script."
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hook": {
      "type": "string",
      "minLength": 1
    },
    "script_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "section_title",
          "section_role",
          "planned_narration_wpm",
          "narration",
          "spoken_overrides",
          "delivery_cues"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^sec_[0-9]{3}$"
          },
          "section_title": {
            "type": "string"
          },
          "section_role": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "planned_narration_wpm": {
            "type": "integer",
            "minimum": 80,
            "maximum": 300,
            "description": "LLM-authored exact narration pace for this section. Must remain within source_user_input.narration_wpm and is the downstream Voice target."
          },
          "spoken_overrides": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/spoken_override"
            }
          },
          "delivery_cues": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/delivery_cue"
            }
          }
        }
      }
    },
    "full_script": {
      "type": "string",
      "minLength": 1
    },
    "section_word_counts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "actual_word_count"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^sec_[0-9]{3}$"
          },
          "actual_word_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "generation_mode": {
      "const": "research_assisted"
    },
    "source_research_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_duration_minutes",
        "planned_average_wpm",
        "actual_word_count",
        "estimated_duration_minutes",
        "runtime_delta_minutes",
        "runtime_delta_seconds",
        "runtime_delta_percent",
        "section_runtime_diagnostics"
      ],
      "properties": {
        "target_duration_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "planned_average_wpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 240
        },
        "actual_word_count": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_duration_minutes": {
          "type": "number",
          "minimum": 0
        },
        "runtime_delta_minutes": {
          "type": "number"
        },
        "runtime_delta_seconds": {
          "type": "integer"
        },
        "runtime_delta_percent": {
          "type": "number"
        },
        "section_runtime_diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "planned_narration_wpm",
              "actual_word_count",
              "estimated_duration_minutes"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "pattern": "^sec_[0-9]{3}$"
              },
              "planned_narration_wpm": {
                "type": "integer",
                "minimum": 80,
                "maximum": 240
              },
              "actual_word_count": {
                "type": "integer",
                "minimum": 0
              },
              "estimated_duration_minutes": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "video_pacing_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "profile_name",
        "policy",
        "density_profiles"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ],
          "description": "User-selected per-video pacing mode."
        },
        "profile_name": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ]
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "density_profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "high": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "preferred_hold_seconds"
              ],
              "properties": {
                "preferred_hold_seconds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            },
            "medium": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "preferred_hold_seconds"
              ],
              "properties": {
                "preferred_hold_seconds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            },
            "low": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "preferred_hold_seconds"
              ],
              "properties": {
                "preferred_hold_seconds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "spoken_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchor_quote",
        "context_quote",
        "spoken_text",
        "source_start",
        "source_end"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sov_sec_[0-9]{3}_[0-9]{3}$"
        },
        "anchor_quote": {
          "type": "string",
          "minLength": 1
        },
        "context_quote": {
          "type": "string",
          "minLength": 1
        },
        "spoken_text": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "[<>]"
          }
        },
        "source_start": {
          "type": "integer",
          "minimum": 0
        },
        "source_end": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "delivery_cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "anchor_quote",
        "context_quote",
        "kind",
        "pause_strength",
        "source_offset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dvc_sec_[0-9]{3}_[0-9]{3}$"
        },
        "anchor_quote": {
          "type": "string",
          "minLength": 1
        },
        "context_quote": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "pause_after"
        },
        "pause_strength": {
          "type": "string",
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "source_offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "script_topic_idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idea_id",
        "title",
        "core_question",
        "viewer_hook",
        "topic_angle",
        "tone",
        "content_tags",
        "risk_notes",
        "pov_style",
        "avoid",
        "recommended_pacing_mode",
        "pacing_mode_reason"
      ],
      "properties": {
        "idea_id": {
          "type": "string",
          "pattern": "^idea_[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "core_question": {
          "type": "string"
        },
        "viewer_hook": {
          "type": "string"
        },
        "topic_angle": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "content_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pov_style": {
          "type": "string",
          "minLength": 1
        },
        "avoid": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_pacing_mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ],
          "description": "Recommended per-video visual pacing mode for Script authoring. The user may override it before building Script & Analysis."
        },
        "pacing_mode_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Concise reason the topic's story/evidence structure naturally supports the recommended pacing mode."
        }
      }
    }
  }
}
