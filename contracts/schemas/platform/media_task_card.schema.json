{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/media_task_card.schema.json",
  "title": "Media Task Card V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_task_id",
          "batch_id",
          "entity_type",
          "entity_id",
          "candidate_index",
          "status",
          "model",
          "aspect_ratio",
          "selected",
          "locked",
          "created_at",
          "provider_status",
          "provider_submitted_at",
          "thumbnail_url",
          "result_url",
          "prompt_preview",
          "completed_at"
        ],
        "properties": {
          "media_task_id": {
            "type": "string",
            "minLength": 1
          },
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "character",
              "location",
              "prop",
              "recurring_visual_subject",
              "beat"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_index": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "submitted",
              "provider_pending",
              "provider_running",
              "downloading",
              "completed",
              "failed",
              "canceled",
              "download_failed"
            ]
          },
          "provider_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              null
            ]
          },
          "thumbnail_url": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "result_url": {
            "type": "string",
            "minLength": 1
          },
          "prompt_preview": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "enum": [
              "nano_banana_2",
              "nano_banana_pro"
            ]
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "1:1",
              "3:4",
              "4:3",
              "9:16",
              "16:9"
            ]
          },
          "selected": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "provider_submitted_at": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
