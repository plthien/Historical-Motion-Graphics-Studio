{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/media_image_generate_response.schema.json",
  "title": "Media Image Generate Response V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "tasks", "summary_url"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["media_task_id", "status", "entity_type", "entity_id", "candidate_index"],
        "properties": {
          "media_task_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["queued", "submitted", "failed"]},
          "entity_type": {"type": "string", "enum": ["character", "location", "prop", "recurring_visual_subject"]},
          "entity_id": {"type": "string", "minLength": 1},
          "candidate_index": {"type": "integer", "minimum": 1}
        }
      }
    },
    "summary_url": {"type": "string", "minLength": 1}
  }
}
