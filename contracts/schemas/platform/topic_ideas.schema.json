{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/topic_ideas.schema.json",
  "title": "Topic Ideas V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "channel_context",
    "source_user_input",
    "ideas"
  ],
  "properties": {
    "artifact_type": {
      "const": "topic_ideas"
    },
    "schema_version": {
      "const": "1.0"
    },
    "channel_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "language"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "source_user_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed_topic",
        "topic_count",
        "focus_keywords",
        "focus",
        "avoid_topics"
      ],
      "properties": {
        "seed_topic": {
          "type": "string"
        },
        "topic_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "focus_keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "focus": {
          "enum": [
            "highest_ctr",
            "most_evergreen",
            "easiest_to_make",
            "balanced",
            "most_unique"
          ]
        },
        "avoid_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic_idea"
      }
    }
  },
  "$defs": {
    "topic_idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idea_id",
        "title",
        "core_question",
        "viewer_hook",
        "topic_angle",
        "tone",
        "ctr_score",
        "difficulty",
        "content_tags",
        "risk_notes",
        "pov_style",
        "avoid",
        "recommended_pacing_mode",
        "pacing_mode_reason"
      ],
      "properties": {
        "idea_id": {
          "type": "string",
          "pattern": "^idea_[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "core_question": {
          "type": "string",
          "minLength": 1
        },
        "viewer_hook": {
          "type": "string",
          "minLength": 1
        },
        "topic_angle": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "ctr_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "content_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pov_style": {
          "type": "string",
          "minLength": 1,
          "description": "Topic-level recommended Script point of view and narration style."
        },
        "avoid": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Topic-level recommended Script treatments, claims, framing, or content to avoid."
        },
        "recommended_pacing_mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ],
          "description": "Recommended per-video visual pacing mode for Script authoring. The user may override it before building Script & Analysis."
        },
        "pacing_mode_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Concise reason the topic's story/evidence structure naturally supports the recommended pacing mode."
        }
      }
    }
  }
}
