{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/script_and_analysis_external_output_v2.schema.json",
  "title": "External Script and Analysis Output V2",
  "description": "One Script and Script Analysis response. V2 requires spoken_overrides and delivery_cues on every raw Script section. Return only the fields defined by this schema; generated section IDs and canonical full_script offsets are outside this response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_ids",
    "script",
    "analysis"
  ],
  "properties": {
    "artifact_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "analysis"
      ],
      "properties": {
        "script": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$",
          "description": "Reserved Artifact ID copied exactly from the generated prompt."
        },
        "analysis": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$",
          "description": "Reserved Artifact ID copied exactly from the generated prompt."
        }
      },
      "description": "Reserved Script and Script Analysis Artifact IDs copied exactly from the generated prompt."
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "hook",
        "script_sections"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "hook": {
          "type": "string",
          "minLength": 1
        },
        "script_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://youtube-ai-studio.local/contracts/schemas/platform/generate_script_llm_raw_output.schema.json#/$defs/raw_script_section"
          }
        }
      }
    },
    "analysis": {
      "$ref": "https://youtube-ai-studio.local/contracts/schemas/platform/script_and_analysis_external_output_v1.schema.json#/properties/analysis"
    }
  }
}
