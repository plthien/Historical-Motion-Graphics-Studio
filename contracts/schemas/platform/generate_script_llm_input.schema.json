{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/generate_script_llm_input.schema.json",
  "title": "Generate Script LLM Input V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "channel_context",
    "narration_identity",
    "topic_idea",
    "user_input",
    "video_pacing_profile",
    "authoring_constraints"
  ],
  "properties": {
    "channel_context": {
      "$ref": "#/$defs/channel_context"
    },
    "narration_identity": {
      "$ref": "#/$defs/narration_identity"
    },
    "topic_idea": {
      "$ref": "#/$defs/script_topic_idea"
    },
    "user_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_duration_minutes",
        "pov_style",
        "avoid",
        "section_count_mode",
        "pacing_mode",
        "narration_wpm"
      ],
      "properties": {
        "target_duration_minutes": {
          "type": "number",
          "minimum": 1
        },
        "pov_style": {
          "type": "string",
          "minLength": 1
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "section_count_mode": {
          "type": "string",
          "enum": [
            "llm_decides",
            "backend_plan"
          ],
          "description": "Section planning mode selected by the user."
        },
        "pacing_mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ]
        },
        "narration_wpm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 80,
              "maximum": 300
            },
            "max": {
              "type": "integer",
              "minimum": 80,
              "maximum": 300
            }
          },
          "description": "Inclusive WPM range for this build. The model chooses one exact planned_narration_wpm per Script section within this range."
        }
      }
    },
    "authoring_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_count_mode",
        "recommended_section_count",
        "minimum_section_count",
        "maximum_section_count",
        "section_plan"
      ],
      "properties": {
        "section_count_mode": {
          "type": "string",
          "enum": [
            "llm_decides",
            "backend_plan"
          ]
        },
        "recommended_section_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "minimum_section_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "maximum_section_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12
        },
        "section_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_index",
              "section_role"
            ],
            "properties": {
              "section_index": {
                "type": "integer",
                "minimum": 1
              },
              "section_role": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "Populated only for backend_plan. It fixes section topology but does not prescribe section-level word quotas."
        }
      }
    },
    "video_pacing_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "profile_name",
        "policy",
        "density_profiles"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ],
          "description": "User-selected per-video pacing mode."
        },
        "profile_name": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ]
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "density_profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "high": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "preferred_hold_seconds"
              ],
              "properties": {
                "preferred_hold_seconds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            },
            "medium": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "preferred_hold_seconds"
              ],
              "properties": {
                "preferred_hold_seconds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            },
            "low": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "preferred_hold_seconds"
              ],
              "properties": {
                "preferred_hold_seconds": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min",
                    "max"
                  ],
                  "properties": {
                    "min": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "max": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "channel_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "language",
        "niche",
        "audience"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "niche": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        }
      }
    },
    "script_topic_idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "core_question",
        "viewer_hook",
        "topic_angle",
        "tone",
        "content_tags",
        "risk_notes",
        "pov_style",
        "avoid",
        "recommended_pacing_mode",
        "pacing_mode_reason"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "core_question": {
          "type": "string"
        },
        "viewer_hook": {
          "type": "string"
        },
        "topic_angle": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "content_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pov_style": {
          "type": "string",
          "minLength": 1,
          "description": "Topic-level recommended Script POV style."
        },
        "avoid": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Topic-level recommended Script avoid guidance."
        },
        "recommended_pacing_mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ],
          "description": "Recommended per-video visual pacing mode for Script authoring. The user may override it before building Script & Analysis."
        },
        "pacing_mode_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Concise reason the topic's story/evidence structure naturally supports the recommended pacing mode."
        }
      }
    },
    "narration_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "delivery",
        "explanation_style",
        "tone_boundaries",
        "avoid"
      ],
      "properties": {
        "voice": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "delivery": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "explanation_style": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tone_boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "description": "Free-form channel-level narration intent frozen in the Project Channel DNA. No creative style enum or backend-authored default is implied."
    }
  }
}
