{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topic Ideas LLM Raw Output V3",
  "description": "Topic Ideas response. Copy the reserved artifact_id exactly from the generated prompt. Return only the fields defined by this schema; idea IDs and source-tracking fields are outside this response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "ideas"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$",
      "description": "Reserved Artifact ID copied exactly from the generated prompt."
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/raw_topic_idea"
      }
    }
  },
  "$defs": {
    "raw_topic_idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "core_question",
        "viewer_hook",
        "topic_angle",
        "tone",
        "ctr_score",
        "difficulty",
        "content_tags",
        "risk_notes",
        "pov_style",
        "avoid",
        "recommended_pacing_mode",
        "pacing_mode_reason"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "core_question": {
          "type": "string",
          "minLength": 1
        },
        "viewer_hook": {
          "type": "string",
          "minLength": 1
        },
        "topic_angle": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string",
          "minLength": 1
        },
        "ctr_score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "content_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pov_style": {
          "type": "string",
          "minLength": 1,
          "description": "Recommended point of view and narration style for the future Script. The user may edit this recommendation before building the Script & Analysis prompt."
        },
        "avoid": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Recommended Script treatments, claims, framing, or content to avoid. The user may edit this list before building the Script & Analysis prompt."
        },
        "recommended_pacing_mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ],
          "description": "Recommended per-video visual pacing mode for Script authoring. The user may override it before building Script & Analysis."
        },
        "pacing_mode_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Concise reason the topic's story/evidence structure naturally supports the recommended pacing mode."
        }
      }
    }
  }
}
