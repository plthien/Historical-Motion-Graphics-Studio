{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/script_read_response.schema.json",
  "title": "Script Read Response V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated",
    "artifact_id",
    "artifact"
  ],
  "properties": {
    "generated": {
      "type": "boolean"
    },
    "artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact": {
      "oneOf": [
        {
          "$ref": "#/$defs/script_artifact"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generated": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "artifact_id": {
            "type": "null"
          },
          "artifact": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generated": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact": {
            "$ref": "#/$defs/script_artifact"
          }
        }
      }
    }
  ],
  "$defs": {
    "script_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "channel_context",
        "source_topic_ideas_artifact_id",
        "source_topic_idea",
        "source_user_input",
        "video_pacing_profile",
        "planned_average_wpm",
        "computed_constraints",
        "title",
        "hook",
        "script_sections",
        "full_script",
        "section_word_counts",
        "word_count",
        "runtime_diagnostics"
      ],
      "properties": {
        "artifact_type": {
          "const": "script"
        },
        "schema_version": {
          "const": "1.0"
        },
        "channel_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "language"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          }
        },
        "source_topic_ideas_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "source_topic_idea": {
          "$ref": "#/$defs/script_topic_idea"
        },
        "source_user_input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_duration_minutes",
            "pov_style",
            "avoid",
            "section_count_mode",
            "pacing_mode"
          ],
          "properties": {
            "target_duration_minutes": {
              "type": "number",
              "minimum": 1
            },
            "pov_style": {
              "type": "string"
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "section_count_mode": {
              "type": "string",
              "enum": [
                "llm_decides",
                "backend_plan"
              ],
              "description": "Section planning mode used for this Script."
            },
            "pacing_mode": {
              "type": "string",
              "enum": [
                "fast",
                "medium",
                "slow"
              ],
              "description": "Per-video pacing mode selected when this Script prompt was built."
            }
          }
        },
        "planned_average_wpm": {
          "type": "integer",
          "minimum": 80,
          "maximum": 240,
          "description": "Backend-derived whole-video aggregate narration pace computed from section word counts and section-specific planned_narration_wpm values. It is diagnostic, not a uniform section authoring speed."
        },
        "computed_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "derived_planned_average_wpm",
            "planned_narration_wpm_range",
            "section_count_mode",
            "recommended_section_count",
            "minimum_section_count",
            "maximum_section_count"
          ],
          "properties": {
            "section_count_mode": {
              "type": "string",
              "enum": [
                "llm_decides",
                "backend_plan"
              ]
            },
            "recommended_section_count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 12
            },
            "minimum_section_count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 12
            },
            "maximum_section_count": {
              "type": "integer",
              "minimum": 3,
              "maximum": 12
            },
            "derived_planned_average_wpm": {
              "type": "integer",
              "minimum": 80,
              "maximum": 240,
              "description": "Backend-derived aggregate planned narration pace."
            },
            "planned_narration_wpm_range": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "const": 80
                },
                "maximum": {
                  "const": 240
                }
              }
            }
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "hook": {
          "type": "string",
          "minLength": 1
        },
        "script_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "section_title",
              "section_role",
              "planned_narration_wpm",
              "narration"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "pattern": "^sec_[0-9]{3}$"
              },
              "section_title": {
                "type": "string"
              },
              "section_role": {
                "type": "string"
              },
              "narration": {
                "type": "string"
              },
              "planned_narration_wpm": {
                "type": "integer",
                "minimum": 80,
                "maximum": 240,
                "description": "Section-specific planned narration pace selected before drafting this section."
              }
            }
          }
        },
        "full_script": {
          "type": "string",
          "minLength": 1
        },
        "section_word_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "actual_word_count"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "pattern": "^sec_[0-9]{3}$"
              },
              "actual_word_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "runtime_diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_duration_minutes",
            "planned_average_wpm",
            "actual_word_count",
            "estimated_duration_minutes",
            "runtime_delta_minutes",
            "runtime_delta_seconds",
            "runtime_delta_percent",
            "section_runtime_diagnostics"
          ],
          "properties": {
            "target_duration_minutes": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "planned_average_wpm": {
              "type": "integer",
              "minimum": 80,
              "maximum": 240
            },
            "actual_word_count": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_duration_minutes": {
              "type": "number",
              "minimum": 0
            },
            "runtime_delta_minutes": {
              "type": "number"
            },
            "runtime_delta_seconds": {
              "type": "integer"
            },
            "runtime_delta_percent": {
              "type": "number"
            },
            "section_runtime_diagnostics": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "section_id",
                  "planned_narration_wpm",
                  "actual_word_count",
                  "estimated_duration_minutes"
                ],
                "properties": {
                  "section_id": {
                    "type": "string",
                    "pattern": "^sec_[0-9]{3}$"
                  },
                  "planned_narration_wpm": {
                    "type": "integer",
                    "minimum": 80,
                    "maximum": 240
                  },
                  "actual_word_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "estimated_duration_minutes": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "video_pacing_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "profile_name",
            "policy",
            "density_profiles"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "fast",
                "medium",
                "slow"
              ],
              "description": "User-selected per-video pacing mode."
            },
            "profile_name": {
              "type": "string",
              "enum": [
                "fast",
                "medium",
                "slow"
              ]
            },
            "policy": {
              "type": "string",
              "minLength": 1
            },
            "density_profiles": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "high",
                "medium",
                "low"
              ],
              "properties": {
                "high": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "preferred_hold_seconds"
                  ],
                  "properties": {
                    "preferred_hold_seconds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "min",
                        "max"
                      ],
                      "properties": {
                        "min": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "max": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    }
                  }
                },
                "medium": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "preferred_hold_seconds"
                  ],
                  "properties": {
                    "preferred_hold_seconds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "min",
                        "max"
                      ],
                      "properties": {
                        "min": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "max": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    }
                  }
                },
                "low": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "preferred_hold_seconds"
                  ],
                  "properties": {
                    "preferred_hold_seconds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "min",
                        "max"
                      ],
                      "properties": {
                        "min": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "max": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "script_topic_idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idea_id",
        "title",
        "core_question",
        "viewer_hook",
        "topic_angle",
        "tone",
        "content_tags",
        "risk_notes",
        "pov_style",
        "avoid",
        "recommended_pacing_mode",
        "pacing_mode_reason"
      ],
      "properties": {
        "idea_id": {
          "type": "string",
          "pattern": "^idea_[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "core_question": {
          "type": "string"
        },
        "viewer_hook": {
          "type": "string"
        },
        "topic_angle": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "content_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pov_style": {
          "type": "string",
          "minLength": 1
        },
        "avoid": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommended_pacing_mode": {
          "type": "string",
          "enum": [
            "fast",
            "medium",
            "slow"
          ],
          "description": "Recommended per-video visual pacing mode for Script authoring. The user may override it before building Script & Analysis."
        },
        "pacing_mode_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Concise reason the topic's story/evidence structure naturally supports the recommended pacing mode."
        }
      }
    }
  }
}
