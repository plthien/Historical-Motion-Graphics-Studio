{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/media_image_generate_request.schema.json",
  "title": "Media Image Generate Request V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "project_id",
    "entity_type",
    "entity_id",
    "candidate_count",
    "prompt",
    "negative_prompt",
    "model",
    "aspect_ratio",
    "upscale"
  ],
  "properties": {
    "purpose": {
      "type": "string",
      "enum": ["style_bible_reference_image"]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "style_bible_revision_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "entity_type": {
      "type": "string",
      "enum": ["character", "location", "prop", "recurring_visual_subject"]
    },
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "negative_prompt": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "enum": ["nano_banana_2", "nano_banana_pro"]
    },
    "aspect_ratio": {
      "type": "string",
      "enum": ["1:1", "3:4", "4:3", "9:16", "16:9"]
    },
    "upscale": {
      "$ref": "#/$defs/upscale"
    }
  },
  "$defs": {
    "upscale": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "array",
          "minItems": 1,
          "prefixItems": [{"const": "2K"}],
          "items": false
        },
        {
          "type": "array",
          "minItems": 1,
          "prefixItems": [{"const": "4K"}],
          "items": false
        },
        {
          "type": "array",
          "minItems": 2,
          "prefixItems": [{"const": "2K"}, {"const": "4K"}],
          "items": false
        }
      ]
    }
  }
}
