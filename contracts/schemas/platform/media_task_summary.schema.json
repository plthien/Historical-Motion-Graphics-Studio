{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/media_task_summary.schema.json",
  "title": "Media Task Summary V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "purpose",
    "total",
    "queued",
    "submitted",
    "provider_pending",
    "provider_running",
    "downloading",
    "completed",
    "failed",
    "canceled",
    "download_failed",
    "selected",
    "locked",
    "updated_at"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "enum": [
        "style_bible_visual_reference",
        "scene_asset_generation"
      ]
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "queued": {
      "type": "integer",
      "minimum": 0
    },
    "submitted": {
      "type": "integer",
      "minimum": 0
    },
    "provider_pending": {
      "type": "integer",
      "minimum": 0
    },
    "provider_running": {
      "type": "integer",
      "minimum": 0
    },
    "downloading": {
      "type": "integer",
      "minimum": 0
    },
    "completed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "canceled": {
      "type": "integer",
      "minimum": 0
    },
    "download_failed": {
      "type": "integer",
      "minimum": 0
    },
    "selected": {
      "type": "integer",
      "minimum": 0
    },
    "locked": {
      "type": "integer",
      "minimum": 0
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
