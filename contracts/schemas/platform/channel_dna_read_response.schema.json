{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/channel_dna_read_response.schema.json",
  "title": "Channel DNA Read Response V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["channel_id", "has_channel_dna", "channel_dna", "updated_at"],
  "properties": {
    "channel_id": {
      "type": "string",
      "minLength": 1
    },
    "has_channel_dna": {
      "type": "boolean"
    },
    "channel_dna": {
      "oneOf": [
        {
          "$ref": "channel_dna.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": ["string", "null"]
    }
  }
}
