{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/platform/script_analysis_continuity_review_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "project_id",
    "review_revision_id",
    "source_script_artifact_id",
    "source_script_analysis_artifact_id",
    "removed_continuity_refs"
  ],
  "properties": {
    "artifact_type": {"const": "script_analysis_continuity_review"},
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^project_[0-9a-f]{12}$"},
    "review_revision_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{12}$"},
    "source_script_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{12}$"},
    "source_script_analysis_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{12}$"},
    "removed_continuity_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(char|loc|prop|subject)_[0-9]{3}$"}
    }
  }
}
