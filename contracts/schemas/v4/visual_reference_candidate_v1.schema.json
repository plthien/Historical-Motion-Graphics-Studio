{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/schemas/v4/visual_reference_candidate_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "reference_artifact_id",
    "project_id",
    "source_script_revision_id",
    "source_script_analysis_revision_id",
    "source_style_bible_revision_id",
    "operation_id",
    "anchor_type",
    "anchor_id",
    "source_definition_hash",
    "media_artifact_id",
    "media_task_id",
    "candidate_index",
    "mime_type",
    "media_sha256",
    "file_url",
    "created_at"
  ],
  "properties": {
    "artifact_type": {"const": "style_bible_visual_reference"},
    "schema_version": {"const": "2.0"},
    "reference_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{12}$"},
    "project_id": {"type": "string", "pattern": "^project_[0-9a-f]{12}$"},
    "source_script_revision_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{12}$"},
    "source_script_analysis_revision_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{12}$"},
    "source_style_bible_revision_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{12}$"},
    "operation_id": {"type": "string", "pattern": "^operation_[0-9a-f]{12}$"},
    "anchor_type": {"enum": ["character", "location", "prop", "recurring_visual_subject"]},
    "anchor_id": {"type": "string", "pattern": "^(char|loc|prop|subject)_[0-9]{3}$"},
    "source_definition_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "media_artifact_id": {"type": "string", "pattern": "^artifact_[0-9a-f]{12}$"},
    "media_task_id": {"type": "string", "pattern": "^media_task_[0-9a-f]{12}$"},
    "candidate_index": {"type": "integer", "minimum": 1},
    "mime_type": {"type": "string", "minLength": 1},
    "media_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_url": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  }
}
