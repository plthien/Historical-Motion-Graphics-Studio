{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_scene_authoring_input_v1.schema.json",
  "title": "Scene Breakdown Micro-Scene Authoring Input V1",
  "description": "Step-1 decision surface containing each fixed Scene source once and every technically legal Beat boundary marker. Backend owns timing and source legality; Step 1 owns the semantic boundary subset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "title",
    "sections",
    "scene_authoring_plan"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "section_order",
          "section_title",
          "section_role"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^sec_[0-9]{3}$"
          },
          "section_order": {
            "type": "integer",
            "minimum": 1
          },
          "section_title": {
            "type": "string",
            "minLength": 1
          },
          "section_role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scene_authoring_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "scenes"
            ],
            "properties": {
              "section_id": {
                "type": "string",
                "pattern": "^sec_[0-9]{3}$"
              },
              "scenes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/scene"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "boundary_id_after"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Exact frozen-Script source segment. Ordered source_segments text reconstructs the Scene source character-for-character."
        },
        "boundary_id_after": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^boundary_[0-9]{3}$",
          "description": "Exposed technically legal Beat boundary immediately after this exact source segment, or null for the final Scene segment."
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_key",
        "visual_context_ref",
        "source_segments"
      ],
      "properties": {
        "scene_key": {
          "type": "string",
          "pattern": "^sec_[0-9]{3}_scene_[0-9]{3}$"
        },
        "visual_context_ref": {
          "type": "string",
          "pattern": "^ctx_[0-9]{3}$",
          "description": "Read-only backend-resolved visual context for every Beat inside this fixed Scene."
        },
        "source_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          },
          "description": "Complete source-once lattice. Concatenate source_segments[].text to recover the exact Scene source. Every non-null boundary_id_after is technically legal and selectable by Step 1."
        }
      }
    }
  }
}
