{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_scene_llm_output_v2.schema.json",
  "title": "Scene Breakdown Micro-Scene Semantic Authoring Output V2",
  "description": "Step 1 external output over backend-owned micro-Scenes and legal Beat boundary IDs. The model selects an ordered legal boundary subset and authors semantic Beat metadata; it does not author source text, offsets, timestamps, or Scene boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "sections"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "scenes"],
        "properties": {
          "section_id": {"type": "string", "pattern": "^sec_[0-9]{3}$"},
          "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scene_key", "partition", "beats"],
              "properties": {
                "scene_key": {
                  "type": "string",
                  "pattern": "^sec_[0-9]{3}_scene_[0-9]{3}$"
                },
                "partition": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["boundary_ids"],
                  "properties": {
                    "boundary_ids": {
                      "type": "array",
                      "items": {"type": "string", "pattern": "^boundary_[0-9]{3}$"},
                      "uniqueItems": true
                    }
                  }
                },
                "beats": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "meaning_now",
                      "visible_state_now",
                      "delta_now",
                      "continuity_with_previous"
                    ],
                    "properties": {
                      "meaning_now": {"type": "string", "minLength": 1, "maxLength": 320},
                      "visible_state_now": {"type": "string", "minLength": 1, "maxLength": 360},
                      "delta_now": {"type": "string", "minLength": 1, "maxLength": 280},
                      "continuity_with_previous": {
                        "type": "string",
                        "enum": [
                          "new_setup",
                          "same_setup",
                          "match_subject",
                          "match_location",
                          "match_composition",
                          "graphic_sequence"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
