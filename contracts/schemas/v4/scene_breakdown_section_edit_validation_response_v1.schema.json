{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_section_edit_validation_response_v1.schema.json",
  "title": "Scene Breakdown Section Edit Validation Response V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["valid", "validation_artifact_id", "errors", "warnings"],
  "properties": {
    "valid": { "type": "boolean" },
    "validation_artifact_id": {
      "oneOf": [
        { "type": "string", "pattern": "^artifact_[0-9a-f]{12}$" },
        { "type": "null" }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "code", "message"],
        "properties": {
          "path": { "type": "string" },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
