{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/script_analysis_llm_input_v1.schema.json",
  "title": "Script Analysis LLM Input V1",
  "description": "Identity-bearing, section-preserving input for Script Analysis. The ordered Script sections are the sole narration source and immutable production boundaries owned by the Script artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "source_script_revision_id",
    "script"
  ],
  "properties": {
    "project_id": {
      "$ref": "#/$defs/project_id"
    },
    "source_script_revision_id": {
      "$ref": "#/$defs/artifact_id"
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section_id",
              "section_order",
              "section_title",
              "section_role",
              "narration"
            ],
            "properties": {
              "section_id": {
                "$ref": "#/$defs/section_id"
              },
              "section_order": {
                "type": "integer",
                "minimum": 1
              },
              "section_title": {
                "type": "string",
                "minLength": 1
              },
              "section_role": {
                "type": "string",
                "minLength": 1
              },
              "narration": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "section_id": {
      "type": "string",
      "pattern": "^sec_[0-9]{3}$"
    }
  }
}
