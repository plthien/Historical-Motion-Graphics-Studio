{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/prompt_composer_input_v1.schema.json",
  "$defs": {
    "EntityStyleModel": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "items": {
            "type": "string"
          },
          "title": "Appearance",
          "type": "array"
        },
        "avoid": {
          "items": {
            "type": "string"
          },
          "title": "Avoid",
          "type": "array"
        }
      },
      "required": [
        "appearance",
        "avoid"
      ],
      "title": "EntityStyleModel",
      "type": "object"
    },
    "EntityStylesModel": {
      "additionalProperties": false,
      "properties": {
        "character": {
          "$ref": "#/$defs/EntityStyleModel"
        },
        "location": {
          "$ref": "#/$defs/EntityStyleModel"
        },
        "prop": {
          "$ref": "#/$defs/EntityStyleModel"
        },
        "recurring_visual_subject": {
          "$ref": "#/$defs/EntityStyleModel"
        }
      },
      "required": [
        "character",
        "location",
        "prop",
        "recurring_visual_subject"
      ],
      "title": "EntityStylesModel",
      "type": "object"
    },
    "PromptComposerCharacter": {
      "additionalProperties": false,
      "properties": {
        "char_id": {
          "pattern": "^char_[0-9]{3}$",
          "title": "Char Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "explicit_visual_traits": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Explicit Visual Traits",
          "type": "array"
        },
        "identity_markers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Identity Markers",
          "type": "array"
        },
        "continuity_notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Continuity Notes",
          "type": "array"
        },
        "physical_constraints": {
          "items": {"minLength": 1, "type": "string"},
          "title": "Physical Constraints",
          "type": "array"
        }
      },
      "required": [
        "char_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints"
      ],
      "title": "PromptComposerCharacter",
      "type": "object"
    },
    "PromptComposerLocation": {
      "additionalProperties": false,
      "properties": {
        "loc_id": {
          "pattern": "^loc_[0-9]{3}$",
          "title": "Loc Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "explicit_visual_traits": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Explicit Visual Traits",
          "type": "array"
        },
        "identity_markers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Identity Markers",
          "type": "array"
        },
        "continuity_notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Continuity Notes",
          "type": "array"
        },
        "physical_constraints": {
          "items": {"minLength": 1, "type": "string"},
          "title": "Physical Constraints",
          "type": "array"
        }
      },
      "required": [
        "loc_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints"
      ],
      "title": "PromptComposerLocation",
      "type": "object"
    },
    "PromptComposerMotif": {
      "additionalProperties": false,
      "properties": {
        "motif_id": {
          "pattern": "^motif_[0-9]{3}$",
          "title": "Motif Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "motif_id",
        "description"
      ],
      "title": "PromptComposerMotif",
      "type": "object"
    },
    "PromptComposerOptions": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "prompt_language": {
          "const": "en",
          "title": "Prompt Language",
          "type": "string"
        },
        "aspect_ratio": {
          "enum": [
            "1:1",
            "3:4",
            "4:3",
            "9:16",
            "16:9"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "target_asset_role": {
          "const": "beat_visual",
          "title": "Target Asset Role",
          "type": "string"
        },
        "image_count": {
          "const": 1,
          "title": "Image Count",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "prompt_language",
        "aspect_ratio",
        "target_asset_role",
        "image_count"
      ],
      "title": "PromptComposerOptions",
      "type": "object"
    },
    "PromptComposerProp": {
      "additionalProperties": false,
      "properties": {
        "prop_id": {
          "pattern": "^prop_[0-9]{3}$",
          "title": "Prop Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "explicit_visual_traits": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Explicit Visual Traits",
          "type": "array"
        },
        "identity_markers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Identity Markers",
          "type": "array"
        },
        "continuity_notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Continuity Notes",
          "type": "array"
        },
        "physical_constraints": {
          "items": {"minLength": 1, "type": "string"},
          "title": "Physical Constraints",
          "type": "array"
        }
      },
      "required": [
        "prop_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints"
      ],
      "title": "PromptComposerProp",
      "type": "object"
    },
    "PromptComposerRecurringVisualSubject": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "pattern": "^subject_[0-9]{3}$",
          "title": "Subject Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "visual_type": {
          "minLength": 1,
          "title": "Visual Type",
          "type": "string"
        },
        "explicit_visual_traits": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Explicit Visual Traits",
          "type": "array"
        },
        "continuity_notes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Continuity Notes",
          "type": "array"
        },
        "physical_constraints": {
          "items": {"minLength": 1, "type": "string"},
          "title": "Physical Constraints",
          "type": "array"
        }
      },
      "required": [
        "subject_id",
        "label",
        "description",
        "visual_type",
        "explicit_visual_traits",
        "continuity_notes",
        "physical_constraints"
      ],
      "title": "PromptComposerRecurringVisualSubject",
      "type": "object"
    },
    "PromptComposerStyleEntities": {
      "additionalProperties": false,
      "properties": {
        "characters": {
          "items": {
            "$ref": "#/$defs/PromptComposerCharacter"
          },
          "title": "Characters",
          "type": "array"
        },
        "locations": {
          "items": {
            "$ref": "#/$defs/PromptComposerLocation"
          },
          "title": "Locations",
          "type": "array"
        },
        "recurring_props": {
          "items": {
            "$ref": "#/$defs/PromptComposerProp"
          },
          "title": "Recurring Props",
          "type": "array"
        },
        "recurring_visual_subjects": {
          "items": {
            "$ref": "#/$defs/PromptComposerRecurringVisualSubject"
          },
          "title": "Recurring Visual Subjects",
          "type": "array"
        },
        "motifs": {
          "items": {
            "$ref": "#/$defs/PromptComposerMotif"
          },
          "title": "Motifs",
          "type": "array"
        }
      },
      "required": [
        "characters",
        "locations",
        "recurring_props",
        "recurring_visual_subjects",
        "motifs"
      ],
      "title": "PromptComposerStyleEntities",
      "type": "object"
    },
    "PromptComposerVisualBeat": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "pattern": "^scene_[0-9]{3,}$",
          "title": "Scene Id",
          "type": "string"
        },
        "visual_context_ref": {
          "pattern": "^ctx_[0-9]{3}$",
          "title": "Visual Context Ref",
          "type": "string"
        },
        "representation_family": {
          "enum": [
            "character_environment_lived",
            "object_evidence_closeup",
            "text_diagram_editorial"
          ],
          "title": "Representation Family",
          "type": "string"
        },
        "beat_id": {
          "pattern": "^beat_[0-9]{3,}$",
          "title": "Beat Id",
          "type": "string"
        },
        "beat_order": {
          "minimum": 1,
          "title": "Beat Order",
          "type": "integer"
        },
        "local_beat_order": {
          "minimum": 1,
          "title": "Local Beat Order",
          "type": "integer"
        },
        "continuity_group_id": {
          "pattern": "^continuity_[0-9]{3,}$",
          "title": "Continuity Group Id",
          "type": "string"
        },
        "visual_priority": {
          "enum": [
            "critical",
            "high",
            "normal"
          ],
          "title": "Visual Priority",
          "type": "string"
        },
        "is_narrative_marker": {
          "title": "Is Narrative Marker",
          "type": "boolean"
        },
        "selected_character_refs": {
          "items": {
            "pattern": "^char_[0-9]{3}$",
            "type": "string"
          },
          "title": "Selected Character Refs",
          "type": "array"
        },
        "selected_location_refs": {
          "items": {
            "pattern": "^loc_[0-9]{3}$",
            "type": "string"
          },
          "title": "Selected Location Refs",
          "type": "array"
        },
        "selected_prop_refs": {
          "items": {
            "pattern": "^prop_[0-9]{3}$",
            "type": "string"
          },
          "title": "Selected Prop Refs",
          "type": "array"
        },
        "selected_recurring_visual_subject_refs": {
          "items": {
            "pattern": "^subject_[0-9]{3}$",
            "type": "string"
          },
          "title": "Selected Recurring Visual Subject Refs",
          "type": "array"
        },
        "selected_motif_refs": {
          "items": {
            "pattern": "^motif_[0-9]{3}$",
            "type": "string"
          },
          "title": "Selected Motif Refs",
          "type": "array"
        },
        "selected_native_visual_reference_ids": {
          "items": {
            "pattern": "^artifact_[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Selected Native Visual Reference Ids",
          "type": "array"
        },
        "visual_concept": {
          "minLength": 1,
          "title": "Visual Concept",
          "type": "string"
        },
        "subject_action": {
          "minLength": 1,
          "title": "Subject Action",
          "type": "string"
        },
        "environment_emphasis": {
          "minLength": 1,
          "title": "Environment Emphasis",
          "type": "string"
        },
        "framing": {
          "enum": [
            "extreme_wide",
            "wide",
            "medium_wide",
            "medium",
            "medium_close",
            "close_up",
            "extreme_close_up",
            "overhead",
            "insert",
            "graphic_layout"
          ],
          "title": "Framing",
          "type": "string"
        },
        "camera_angle": {
          "enum": [
            "eye_level",
            "low_angle",
            "high_angle",
            "top_down",
            "dutch_angle",
            "pov",
            "neutral_graphic"
          ],
          "title": "Camera Angle",
          "type": "string"
        },
        "camera_movement": {
          "enum": [
            "static",
            "slow_push_in",
            "slow_pull_out",
            "pan_left",
            "pan_right",
            "tilt_up",
            "tilt_down",
            "tracking",
            "subtle_handheld",
            "parallax",
            "none"
          ],
          "title": "Camera Movement",
          "type": "string"
        },
        "composition": {
          "minLength": 1,
          "title": "Composition",
          "type": "string"
        },
        "lighting_direction": {
          "minLength": 1,
          "title": "Lighting Direction",
          "type": "string"
        },
        "color_emphasis": {
          "minLength": 1,
          "title": "Color Emphasis",
          "type": "string"
        },
        "motion_guidance": {
          "minLength": 1,
          "title": "Motion Guidance",
          "type": "string"
        },
        "continuity_with_previous": {
          "enum": [
            "new_setup",
            "same_setup",
            "match_subject",
            "match_location",
            "match_composition",
            "graphic_sequence"
          ],
          "title": "Continuity With Previous",
          "type": "string"
        },
        "previous_beat_image_reference_required": {
          "title": "Previous Beat Image Reference Required",
          "type": "boolean"
        },
        "continuity_notes": {
          "minLength": 1,
          "title": "Continuity Notes",
          "type": "string"
        },
        "production_notes": {
          "minLength": 1,
          "title": "Production Notes",
          "type": "string"
        },
        "negative_requirements": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Negative Requirements",
          "type": "array"
        },
        "visible_text": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Visible Text",
          "type": "array"
        },
        "selected_reference_bindings": {
          "items": {
            "$ref": "#/$defs/PromptReferenceBinding"
          },
          "title": "Selected Reference Bindings",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "beat_id",
        "visual_context_ref",
        "beat_order",
        "local_beat_order",
        "continuity_group_id",
        "visual_priority",
        "is_narrative_marker",
        "representation_family",
        "selected_character_refs",
        "selected_location_refs",
        "selected_prop_refs",
        "selected_recurring_visual_subject_refs",
        "selected_motif_refs",
        "selected_native_visual_reference_ids",
        "visual_concept",
        "subject_action",
        "environment_emphasis",
        "framing",
        "camera_angle",
        "camera_movement",
        "composition",
        "lighting_direction",
        "color_emphasis",
        "motion_guidance",
        "continuity_with_previous",
        "previous_beat_image_reference_required",
        "continuity_notes",
        "production_notes",
        "negative_requirements",
        "visible_text",
        "selected_reference_bindings"
      ],
      "title": "PromptComposerVisualBeat",
      "type": "object"
    },
    "PromptComposerVisualContext": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["story_world", "representative_scenario", "evidence_view", "reconstruction", "neutral_abstract", "mixed_context"],
          "title": "Mode",
          "type": "string"
        },
        "timeframe": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "title": "Timeframe"
        },
        "setting": {
          "anyOf": [{"minLength": 1, "type": "string"}, {"type": "null"}],
          "title": "Setting"
        },
        "constraints": {
          "items": {"minLength": 1, "type": "string"},
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": ["mode", "timeframe", "setting", "constraints"],
      "title": "PromptComposerVisualContext",
      "type": "object"
    },
    "PromptReferenceBinding": {
      "additionalProperties": false,
      "properties": {
        "anchor_type": {
          "enum": [
            "character",
            "location",
            "prop",
            "recurring_visual_subject"
          ],
          "title": "Anchor Type",
          "type": "string"
        },
        "anchor_id": {
          "pattern": "^(char|loc|prop|subject)_[0-9]{3}$",
          "title": "Anchor Id",
          "type": "string"
        },
        "reference_artifact_id": {
          "pattern": "^artifact_[0-9a-f]{12}$",
          "title": "Reference Artifact Id",
          "type": "string"
        },
        "media_artifact_id": {
          "pattern": "^artifact_[0-9a-f]{12}$",
          "title": "Media Artifact Id",
          "type": "string"
        },
        "approval_set_artifact_id": {
          "pattern": "^artifact_[0-9a-f]{12}$",
          "title": "Approval Set Artifact Id",
          "type": "string"
        },
        "source_definition_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Definition Hash",
          "type": "string"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        },
        "mime_type": {
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "image_artifact_id": {
          "pattern": "^artifact_[0-9a-f]{12}$",
          "title": "Image Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "anchor_type",
        "anchor_id",
        "reference_artifact_id",
        "media_artifact_id",
        "approval_set_artifact_id",
        "source_definition_hash",
        "media_sha256",
        "mime_type",
        "image_artifact_id"
      ],
      "title": "PromptReferenceBinding",
      "type": "object"
    },
    "VisualIdentityModel": {
      "additionalProperties": false,
      "properties": {
        "medium": {
          "items": {
            "type": "string"
          },
          "title": "Medium",
          "type": "array"
        },
        "linework": {
          "items": {
            "type": "string"
          },
          "title": "Linework",
          "type": "array"
        },
        "rendering": {
          "items": {
            "type": "string"
          },
          "title": "Rendering",
          "type": "array"
        },
        "palette": {
          "items": {
            "type": "string"
          },
          "title": "Palette",
          "type": "array"
        },
        "shape_language": {
          "items": {
            "type": "string"
          },
          "title": "Shape Language",
          "type": "array"
        },
        "texture": {
          "items": {
            "type": "string"
          },
          "title": "Texture",
          "type": "array"
        }
      },
      "required": [
        "medium",
        "linework",
        "rendering",
        "palette",
        "shape_language",
        "texture"
      ],
      "title": "VisualIdentityModel",
      "type": "object"
    },
    "VisualStyleSnapshotModel": {
      "additionalProperties": false,
      "properties": {
        "visual_identity": {
          "$ref": "#/$defs/VisualIdentityModel"
        },
        "entity_styles": {
          "$ref": "#/$defs/EntityStylesModel"
        },
        "global_negative_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Global Negative Constraints",
          "type": "array"
        }
      },
      "required": [
        "visual_identity",
        "entity_styles",
        "global_negative_constraints"
      ],
      "title": "VisualStyleSnapshotModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^project_[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "source_script_revision_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Source Script Revision Id",
      "type": "string"
    },
    "source_script_analysis_revision_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Source Script Analysis Revision Id",
      "type": "string"
    },
    "source_style_bible_revision_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Source Style Bible Revision Id",
      "type": "string"
    },
    "source_scene_plan_revision_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Source Scene Plan Revision Id",
      "type": "string"
    },
    "source_visual_plan_revision_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Source Visual Plan Revision Id",
      "type": "string"
    },
    "source_visual_reference_approval_set_artifact_id": {
      "anyOf": [
        {
          "pattern": "^artifact_[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Visual Reference Approval Set Artifact Id"
    },
    "prompt_bundle_revision_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Prompt Bundle Revision Id",
      "type": "string"
    },
    "options": {
      "$ref": "#/$defs/PromptComposerOptions"
    },
    "visual_style_snapshot": {
      "$ref": "#/$defs/VisualStyleSnapshotModel"
    },
    "style_entities": {
      "$ref": "#/$defs/PromptComposerStyleEntities"
    },
    "visual_context_catalog": {
      "patternProperties": {
        "^ctx_[0-9]{3}$": {
          "$ref": "#/$defs/PromptComposerVisualContext"
        }
      },
      "title": "Visual Context Catalog",
      "type": "object"
    },
    "visual_beats": {
      "items": {
        "$ref": "#/$defs/PromptComposerVisualBeat"
      },
      "title": "Visual Beats",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
