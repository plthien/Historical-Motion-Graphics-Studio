{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_full_llm_output_v1.schema.json",
  "title": "Full Script Scene Breakdown External Output V1",
  "description": "Full-Script external Scene Breakdown result. The model echoes the reserved paired Artifact IDs and returns every Script section in order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_ids",
    "sections"
  ],
  "properties": {
    "artifact_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_plan",
        "visual_plan"
      ],
      "properties": {
        "scene_plan": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$",
          "description": "Reserved Artifact ID copied exactly from the generated prompt."
        },
        "visual_plan": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$",
          "description": "Reserved Artifact ID copied exactly from the generated prompt."
        }
      },
      "description": "Reserved Scene Plan and Visual Plan Artifact IDs copied exactly from the generated prompt."
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "scenes"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "pattern": "^sec_[0-9]{3}$",
            "description": "Exact input Script section ID."
          },
          "scenes": {
            "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_section_llm_output_v1.schema.json#/properties/scenes"
          }
        }
      }
    }
  }
}
