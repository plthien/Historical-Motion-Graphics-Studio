{
  "$defs": {
    "RationalFrameRateModel": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "maximum": 240000,
          "minimum": 1,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "maximum": 1001,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalFrameRateModel",
      "type": "object"
    },
    "RenderFrameIntervalModel": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "beat_id": {
          "title": "Beat Id",
          "type": "string"
        },
        "beat_order": {
          "minimum": 1,
          "title": "Beat Order",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "end_frame": {
          "exclusiveMinimum": 0,
          "title": "End Frame",
          "type": "integer"
        },
        "frame_count": {
          "minimum": 1,
          "title": "Frame Count",
          "type": "integer"
        },
        "source_start_time_units": {
          "minimum": 0,
          "title": "Source Start Time Units",
          "type": "integer"
        },
        "source_end_time_units": {
          "exclusiveMinimum": 0,
          "title": "Source End Time Units",
          "type": "integer"
        },
        "boundary_error_time_units": {
          "minimum": 0,
          "title": "Boundary Error Time Units",
          "type": "integer"
        }
      },
      "required": [
        "scene_id",
        "beat_id",
        "beat_order",
        "start_frame",
        "end_frame",
        "frame_count",
        "source_start_time_units",
        "source_end_time_units",
        "boundary_error_time_units"
      ],
      "title": "RenderFrameIntervalModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "quantizer_version": {
      "const": "render_frame_quantizer_v1",
      "title": "Quantizer Version",
      "type": "string"
    },
    "frame_rate": {
      "$ref": "#/$defs/RationalFrameRateModel"
    },
    "source_total_duration_time_units": {
      "exclusiveMinimum": 0,
      "title": "Source Total Duration Time Units",
      "type": "integer"
    },
    "total_frame_count": {
      "exclusiveMinimum": 0,
      "title": "Total Frame Count",
      "type": "integer"
    },
    "quantized_duration_time_units": {
      "exclusiveMinimum": 0,
      "title": "Quantized Duration Time Units",
      "type": "integer"
    },
    "total_drift_time_units": {
      "title": "Total Drift Time Units",
      "type": "integer"
    },
    "max_boundary_error_time_units": {
      "minimum": 0,
      "title": "Max Boundary Error Time Units",
      "type": "integer"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/RenderFrameIntervalModel"
      },
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "frame_quantization_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Frame Quantization Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "quantizer_version",
    "frame_rate",
    "source_total_duration_time_units",
    "total_frame_count",
    "quantized_duration_time_units",
    "total_drift_time_units",
    "max_boundary_error_time_units",
    "intervals",
    "frame_quantization_sha256"
