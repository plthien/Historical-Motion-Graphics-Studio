{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_visual_llm_output_v2.schema.json",
  "title": "Scene Breakdown Visual Authoring Output V2",
  "description": "Step 2 external authoring output. Adds one visual decision for every locked Visual-Semantic Scene Plan Beat without changing scene/beat identity, order, source, timing, or locked visual-semantic Beat state/delta.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "scenes"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$",
      "description": "Reserved Visual Plan Artifact ID copied exactly from the generated prompt."
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "beat_plans"],
        "properties": {
          "scene_id": {"type": "string", "pattern": "^scene_[0-9]{3,}$"},
          "beat_plans": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "beat_id",
                "visual_context_ref",
                "representation_family",
                "selected_character_refs",
                "selected_location_refs",
                "selected_prop_refs",
                "selected_recurring_visual_subject_refs",
                "selected_motif_refs",
                "visual_concept",
                "subject_action",
                "environment_emphasis",
                "visible_text",
                "framing",
                "camera_angle",
                "camera_movement",
                "composition",
                "lighting_direction",
                "color_emphasis",
                "previous_beat_image_reference_required"
              ],
              "properties": {
                "beat_id": {"type": "string", "pattern": "^beat_[0-9]{3,}$"},
                "visual_context_ref": {"type": "string", "pattern": "^ctx_[0-9]{3}$", "description": "Exact read-only context ref echoed from the locked Beat."},
                "representation_family": {"type": "string", "enum": ["character_environment_lived", "object_evidence_closeup", "text_diagram_editorial"]},
                "selected_character_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^char_[0-9]{3}$"}},
                "selected_location_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^loc_[0-9]{3}$"}},
                "selected_prop_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^prop_[0-9]{3}$"}},
                "selected_recurring_visual_subject_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^subject_[0-9]{3}$"}},
                "selected_motif_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^motif_[0-9]{3}$"}},
                "visual_concept": {"type": "string", "minLength": 1, "maxLength": 1200},
                "subject_action": {"type": "string", "minLength": 1, "maxLength": 800},
                "environment_emphasis": {"type": "string", "minLength": 1, "maxLength": 800},
                "visible_text": {"type": "array", "uniqueItems": true, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
                "framing": {"type": "string", "enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close_up", "extreme_close_up", "overhead", "insert", "graphic_layout"]},
                "camera_angle": {"type": "string", "enum": ["eye_level", "low_angle", "high_angle", "top_down", "dutch_angle", "pov", "neutral_graphic"]},
                "camera_movement": {"type": "string", "description": "Downstream motion guidance derived from this single frozen keyframe. It must not add another temporal state, consume the next Beat, invent required motion, or replace the locked state delta.", "enum": ["static", "slow_push_in", "slow_pull_out", "pan_left", "pan_right", "tilt_up", "tilt_down", "tracking", "subtle_handheld", "parallax", "none"]},
                "composition": {"type": "string", "minLength": 1},
                "lighting_direction": {"type": ["string", "null"], "maxLength": 160},
                "color_emphasis": {"type": ["string", "null"], "maxLength": 160},
                "previous_beat_image_reference_required": {
                  "type": "boolean",
                  "description": "Whether this frozen still requires the actual rendered immediately previous Beat image as generation input."
                }
              }
            }
          }
        }
      }
    }
  }
}
