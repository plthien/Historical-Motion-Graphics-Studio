{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_reference_operation_request_v1.schema.json",
  "title": "Visual Reference V4 Durable Operation Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_count",
    "aspect_ratios_by_anchor_type",
    "subjects",
    "provider_snapshot",
    "expected_approval_set_artifact_id"
  ],
  "properties": {
    "candidate_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "aspect_ratios_by_anchor_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "location",
        "prop",
        "recurring_visual_subject"
      ],
      "properties": {
        "character": {
          "type": "string",
          "enum": [
            "1:1",
            "3:4",
            "4:3",
            "9:16",
            "16:9"
          ]
        },
        "location": {
          "type": "string",
          "enum": [
            "1:1",
            "3:4",
            "4:3",
            "9:16",
            "16:9"
          ]
        },
        "prop": {
          "type": "string",
          "enum": [
            "1:1",
            "3:4",
            "4:3",
            "9:16",
            "16:9"
          ]
        },
        "recurring_visual_subject": {
          "type": "string",
          "enum": [
            "1:1",
            "3:4",
            "4:3",
            "9:16",
            "16:9"
          ]
        }
      }
    },
    "expected_approval_set_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anchor_type",
          "anchor_id",
          "label",
          "source_definition_hash",
          "prompt",
          "negative_prompt"
        ],
        "properties": {
          "anchor_type": {
            "type": "string",
            "enum": [
              "character",
              "location",
              "prop",
              "recurring_visual_subject"
            ]
          },
          "anchor_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source_definition_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "negative_prompt": {
            "type": "string"
          }
        }
      }
    },
    "provider_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "enabled",
        "base_url",
        "api_key_configured",
        "default_image_model",
        "default_image_aspect_ratio",
        "default_upscale",
        "poll_interval_seconds",
        "max_parallel_tasks",
        "enabled_media_kinds"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "api_key_configured": {
          "type": "boolean"
        },
        "default_image_model": {
          "type": "string",
          "minLength": 1
        },
        "default_image_aspect_ratio": {
          "type": "string",
          "minLength": 1
        },
        "default_upscale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "poll_interval_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "enabled_media_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
