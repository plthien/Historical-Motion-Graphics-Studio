{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/schemas/v4/visual_reference_set_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "project_id",
    "visual_reference_set_artifact_id",
    "parent_visual_reference_set_artifact_id",
    "source_script_revision_id",
    "source_script_analysis_revision_id",
    "source_style_bible_revision_id",
    "status",
    "subjects",
    "created_at"
  ],
  "properties": {
    "artifact_type": {
      "const": "style_bible_visual_reference_set"
    },
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "visual_reference_set_artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "parent_visual_reference_set_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_script_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "source_script_analysis_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "source_style_bible_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "status": {
      "const": "draft_ready"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anchor_type",
          "anchor_id",
          "label",
          "source_definition_hash",
          "prompt",
          "negative_prompt",
          "candidates",
          "selected_draft_reference_artifact_id"
        ],
        "properties": {
          "anchor_type": {
            "enum": [
              "character",
              "location",
              "prop",
              "recurring_visual_subject"
            ]
          },
          "anchor_id": {
            "type": "string",
            "pattern": "^(char|loc|prop|subject)_[0-9]{3}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source_definition_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "negative_prompt": {
            "type": "string"
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reference_artifact_id",
                "media_artifact_id",
                "media_task_id",
                "candidate_index",
                "mime_type",
                "media_sha256",
                "file_url"
              ],
              "properties": {
                "reference_artifact_id": {
                  "type": "string",
                  "pattern": "^artifact_[0-9a-f]{12}$"
                },
                "media_artifact_id": {
                  "type": "string",
                  "pattern": "^artifact_[0-9a-f]{12}$"
                },
                "media_task_id": {
                  "type": "string",
                  "pattern": "^media_task_[0-9a-f]{12}$"
                },
                "candidate_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "mime_type": {
                  "type": "string",
                  "minLength": 1
                },
                "media_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "file_url": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "selected_draft_reference_artifact_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^artifact_[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
