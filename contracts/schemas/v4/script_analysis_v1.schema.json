{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/script_analysis_v1.schema.json",
  "title": "Script Analysis V1",
  "description": "Canonical backend-normalized Script Analysis artifact. It references immutable Script sections by section_id and stores only Script Analysis data plus backend-owned entity IDs, resolved quote spans, deterministic deduplication results, and QC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "project_id",
    "source_script_revision_id",
    "section_guidance",
    "narrative_markers",
    "continuity_catalog",
    "visual_context_catalog",
    "backend_qc"
  ],
  "properties": {
    "artifact_type": {
      "const": "script_analysis"
    },
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "$ref": "#/$defs/project_id"
    },
    "source_script_revision_id": {
      "$ref": "#/$defs/artifact_id"
    },
    "section_guidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section_guidance"
      }
    },
    "narrative_markers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/narrative_marker"
      }
    },
    "continuity_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "locations",
        "recurring_props",
        "recurring_visual_subjects",
        "visual_motifs"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/character"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "recurring_props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prop"
          }
        },
        "recurring_visual_subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recurring_visual_subject"
          }
        },
        "visual_motifs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visual_motif"
          }
        }
      }
    },
    "visual_context_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/visual_context"
      }
    },
    "backend_qc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_coverage_status",
        "quote_resolution_status",
        "entity_deduplication_status",
        "marker_validation_status",
        "visual_context_validation_status",
        "warnings"
      ],
      "properties": {
        "section_coverage_status": {
          "type": "string",
          "enum": [
            "passed",
            "warning",
            "failed"
          ]
        },
        "quote_resolution_status": {
          "type": "string",
          "enum": [
            "passed",
            "warning",
            "failed"
          ]
        },
        "entity_deduplication_status": {
          "type": "string",
          "enum": [
            "passed",
            "warning",
            "failed"
          ]
        },
        "marker_validation_status": {
          "type": "string",
          "enum": [
            "passed",
            "warning",
            "failed"
          ]
        },
        "visual_context_validation_status": {
          "type": "string",
          "enum": [
            "passed",
            "warning",
            "failed"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "section_id": {
      "type": "string",
      "pattern": "^sec_[0-9]{3}$"
    },
    "resolved_span": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "resolved_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_id",
        "section_id",
        "quote",
        "context_quote",
        "resolved_script_span"
      ],
      "properties": {
        "occurrence_id": {
          "type": "string",
          "pattern": "^(char|loc|prop|subject|motif)_occ_[0-9]{3}$"
        },
        "section_id": {
          "$ref": "#/$defs/section_id"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "context_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_script_span": {
          "$ref": "#/$defs/resolved_span"
        }
      }
    },
    "section_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "pacing_density"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/section_id"
        },
        "pacing_density": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "narrative_marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker_id",
        "marker_type",
        "section_id",
        "anchor_quote",
        "context_quote",
        "resolved_script_span",
        "importance",
        "purpose"
      ],
      "properties": {
        "marker_id": {
          "type": "string",
          "pattern": "^marker_[0-9]{3}$"
        },
        "marker_type": {
          "type": "string",
          "enum": [
            "turning_point",
            "reveal",
            "contrast",
            "payoff",
            "emphasis"
          ]
        },
        "section_id": {
          "$ref": "#/$defs/section_id"
        },
        "anchor_quote": {
          "type": "string",
          "minLength": 1
        },
        "context_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_script_span": {
          "$ref": "#/$defs/resolved_span"
        },
        "importance": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "char_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "entity_kind",
        "narrative_role",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/resolved_occurrence"
          }
        },
        "char_id": {
          "type": "string",
          "pattern": "^char_[0-9]{3}$"
        },
        "entity_kind": {
          "type": "string",
          "enum": [
            "human_character",
            "human_group"
          ],
          "description": "Canonical recurring human identity taxonomy: human_character for one recurring individual; human_group for a recurring plural human identity whose continuity matters as a group."
        },
        "narrative_role": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/resolved_presence_range"
          }
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loc_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "location_kind",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/resolved_occurrence"
          }
        },
        "loc_id": {
          "type": "string",
          "pattern": "^loc_[0-9]{3}$"
        },
        "location_kind": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/resolved_presence_range"
          }
        }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prop_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "prop_kind",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/resolved_occurrence"
          }
        },
        "prop_id": {
          "type": "string",
          "pattern": "^prop_[0-9]{3}$"
        },
        "prop_kind": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/resolved_presence_range"
          }
        }
      }
    },
    "recurring_visual_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "label",
        "description",
        "visual_type",
        "explicit_visual_traits",
        "continuity_notes",
        "physical_constraints",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^subject_[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "visual_type": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/resolved_occurrence"
          }
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/resolved_presence_range"
          }
        }
      }
    },
    "visual_motif": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motif_id",
        "label",
        "description",
        "occurrences"
      ],
      "properties": {
        "motif_id": {
          "type": "string",
          "pattern": "^motif_[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/resolved_occurrence"
          }
        }
      }
    },
    "physical_constraints": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "visual_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "label",
        "mode",
        "timeframe",
        "setting",
        "constraints",
        "presence_ranges"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "pattern": "^ctx_[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mode": {
          "type": "string",
          "enum": [
            "story_world",
            "representative_scenario",
            "evidence_view",
            "reconstruction",
            "neutral_abstract",
            "mixed_context"
          ]
        },
        "timeframe": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        },
        "setting": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 300
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/resolved_presence_range"
          }
        }
      }
    },
    "resolved_presence_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "start_quote",
        "end_quote",
        "resolved_script_span"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/section_id"
        },
        "start_quote": {
          "type": "string",
          "minLength": 1
        },
        "end_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_script_span": {
          "$ref": "#/$defs/resolved_span"
        }
      }
    }
  }
}
