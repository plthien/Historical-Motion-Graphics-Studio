{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/project_style_bible_v1.schema.json",
  "title": "Project Style Bible V1 (Script Analysis lineage)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "project_id",
    "style_bible_revision_id",
    "parent_style_bible_revision_id",
    "revision_operation",
    "status",
    "lineage",
    "visual_style_snapshot",
    "characters",
    "locations",
    "recurring_props",
    "recurring_visual_subjects",
    "motifs"
  ],
  "properties": {
    "artifact_type": {
      "const": "project_style_bible"
    },
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "style_bible_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "parent_style_bible_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_operation": {
      "enum": [
        "draft_generation",
        "text_update",
        "text_approval"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "text_approved"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script_analysis_artifact_id",
        "source_script_artifact_id",
        "channel_dna_snapshot_sha256",
        "continuity_review_artifact_id",
        "removed_continuity_refs"
      ],
      "properties": {
        "source_script_artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        "channel_dna_snapshot_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "script_analysis_artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        "continuity_review_artifact_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        "removed_continuity_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(char|loc|prop|subject)_[0-9]{3}$"
          }
        }
      }
    },
    "visual_style_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_identity",
        "entity_styles",
        "global_negative_constraints"
      ],
      "properties": {
        "visual_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "medium",
            "linework",
            "rendering",
            "palette",
            "shape_language",
            "texture",
            "editorial_language"
          ],
          "properties": {
            "medium": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "linework": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "rendering": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "palette": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "shape_language": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "texture": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true
            },
            "editorial_language": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "uniqueItems": true,
              "description": "Required Channel DNA editorial visual communication language. It guides representation-mode choice and editorial compression without changing locked story/evidence meaning.",
              "minItems": 1
            }
          }
        },
        "entity_styles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "character",
            "location",
            "prop",
            "recurring_visual_subject"
          ],
          "properties": {
            "character": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "appearance",
                "avoid"
              ],
              "properties": {
                "appearance": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "uniqueItems": true
                },
                "avoid": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "uniqueItems": true
                }
              }
            },
            "location": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "appearance",
                "avoid"
              ],
              "properties": {
                "appearance": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "uniqueItems": true
                },
                "avoid": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "uniqueItems": true
                }
              }
            },
            "prop": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "appearance",
                "avoid"
              ],
              "properties": {
                "appearance": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "uniqueItems": true
                },
                "avoid": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "uniqueItems": true
                }
              }
            },
            "recurring_visual_subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "appearance",
                "avoid"
              ],
              "properties": {
                "appearance": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "uniqueItems": true
                },
                "avoid": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": ".*\\S.*"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        },
        "global_negative_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "recurring_props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recurring_prop"
      }
    },
    "motifs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/motif"
      }
    },
    "recurring_visual_subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recurring_visual_subject"
      }
    }
  },
  "$defs": {
    "occurrence_resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "context",
        "resolved_script_position",
        "section_id"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "resolved_script_position": {
          "type": "integer",
          "minimum": 0
        },
        "section_id": {
          "type": "string",
          "pattern": "^sec_[0-9]{3}$"
        }
      }
    },
    "motif_occurrence_resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "resolved_script_position"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_script_position": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "char_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "first_mention_quote",
        "resolved_first_mention_position",
        "occurrence_quotes",
        "entity_kind",
        "narrative_role",
        "presence_ranges",
        "approval_status"
      ],
      "properties": {
        "char_id": {
          "type": "string",
          "pattern": "^char_[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "first_mention_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_first_mention_position": {
          "type": "integer",
          "minimum": 0
        },
        "occurrence_quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/occurrence_resolved"
          }
        },
        "approval_status": {
          "enum": [
            "draft",
            "text_approved"
          ]
        },
        "entity_kind": {
          "type": "string",
          "enum": [
            "human_character",
            "human_group"
          ],
          "description": "Canonical recurring human identity taxonomy: human_character for one recurring individual; human_group for a recurring plural human identity whose continuity matters as a group."
        },
        "narrative_role": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_resolved"
          },
          "description": "Immutable Script Analysis provenance describing where the canonical entity is narratively active."
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loc_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "first_mention_quote",
        "resolved_first_mention_position",
        "occurrence_quotes",
        "location_kind",
        "presence_ranges",
        "approval_status"
      ],
      "properties": {
        "loc_id": {
          "type": "string",
          "pattern": "^loc_[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "first_mention_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_first_mention_position": {
          "type": "integer",
          "minimum": 0
        },
        "occurrence_quotes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/occurrence_resolved"
          }
        },
        "approval_status": {
          "enum": [
            "draft",
            "text_approved"
          ]
        },
        "location_kind": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_resolved"
          },
          "description": "Immutable Script Analysis provenance describing where the canonical entity is narratively active."
        }
      }
    },
    "recurring_prop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prop_id",
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "first_mention_quote",
        "resolved_first_mention_position",
        "occurrence_quotes",
        "prop_kind",
        "significance",
        "presence_ranges",
        "approval_status"
      ],
      "properties": {
        "prop_id": {
          "type": "string",
          "pattern": "^prop_[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "first_mention_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_first_mention_position": {
          "type": "integer",
          "minimum": 0
        },
        "occurrence_quotes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/occurrence_resolved"
          }
        },
        "approval_status": {
          "enum": [
            "draft",
            "text_approved"
          ]
        },
        "prop_kind": {
          "type": "string",
          "minLength": 1
        },
        "significance": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_resolved"
          },
          "description": "Immutable Script Analysis provenance describing where the canonical entity is narratively active."
        }
      }
    },
    "motif": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motif_id",
        "label",
        "description",
        "occurrences",
        "approval_status"
      ],
      "properties": {
        "motif_id": {
          "type": "string",
          "pattern": "^motif_[0-9]{3}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/motif_occurrence_resolved"
          }
        },
        "approval_status": {
          "enum": [
            "draft",
            "text_approved"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recurring_visual_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "label",
        "description",
        "visual_type",
        "explicit_visual_traits",
        "continuity_notes",
        "physical_constraints",
        "first_mention_quote",
        "resolved_first_mention_position",
        "occurrence_quotes",
        "presence_ranges",
        "approval_status"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^subject_[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "visual_type": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrence_quotes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/occurrence_resolved"
          }
        },
        "approval_status": {
          "enum": [
            "draft",
            "text_approved"
          ]
        },
        "first_mention_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_first_mention_position": {
          "type": "integer",
          "minimum": 0
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_resolved"
          },
          "description": "Immutable Script Analysis provenance describing where the canonical entity is narratively active."
        }
      }
    },
    "physical_constraints": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "presence_range_resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "start_quote",
        "end_quote",
        "resolved_script_span"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^sec_[0-9]{3}$"
        },
        "start_quote": {
          "type": "string",
          "minLength": 1
        },
        "end_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_script_span": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        }
      }
    }
  }
}
