{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_section_edit_validation_v1.schema.json",
  "title": "Scene Breakdown Section Edit Validation Artifact V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "validation_artifact_id",
    "project_id",
    "source_scene_plan_revision_id",
    "section_id",
    "editable_payload_sha256",
    "editable_section",
    "normalized_fragment",
    "created_at",
    "source_visual_plan_revision_id"
  ],
  "properties": {
    "artifact_type": {
      "const": "scene_breakdown_section_edit_validation"
    },
    "schema_version": {
      "const": "1.0"
    },
    "validation_artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "source_scene_plan_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "section_id": {
      "type": "string",
      "pattern": "^sec_[0-9]{3,}$"
    },
    "editable_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "editable_section": {
      "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_section_editable_v1.schema.json"
    },
    "normalized_fragment": {
      "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_run_v1.schema.json#/$defs/section_fragment"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_visual_plan_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$",
      "description": "Exact paired Visual Plan draft that was validated with the editable section."
    }
  }
}
