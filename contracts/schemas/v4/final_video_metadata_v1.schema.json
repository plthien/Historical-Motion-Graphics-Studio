    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "video_codec": {
      "const": "h264",
      "title": "Video Codec",
      "type": "string"
    },
    "pixel_format": {
      "const": "yuv420p",
      "title": "Pixel Format",
      "type": "string"
    },
