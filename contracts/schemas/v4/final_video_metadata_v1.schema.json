        "numerator": {
          "maximum": 240000,
          "minimum": 1,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "maximum": 1001,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalFrameRateModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
