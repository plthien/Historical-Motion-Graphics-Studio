{
  "additionalProperties": false,
  "properties": {
    "expected_scene_asset_manifest_artifact_id": {
      "anyOf": [
        {
          "pattern": "^artifact_[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Scene Asset Manifest Artifact Id"
    },
    "frozen_reference_bindings_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Frozen Reference Bindings Hash",
      "type": "string"
    },
    "media_batch_id": {
      "pattern": "^media_batch_[0-9a-f]{12}$",
      "title": "Media Batch Id",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^scene_asset_operation_[0-9a-f]{12}$",
      "title": "Operation Id",
      "type": "string"
    },
    "operation_type": {
      "enum": [
        "generate_all",
        "generate_section",
        "generate_beat",
        "generate_missing",
        "retry_failed",
        "retry_beat",
        "regenerate_beat",
        "regenerate_section"
      ],
      "title": "Operation Type",
      "type": "string"
    },
    "project_id": {
      "pattern": "^project_[0-9a-f]{12}$",
      "title": "Project Id",
      "type": "string"
    },
    "prompt_bundle_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Prompt Bundle Artifact Id",
      "type": "string"
    },
    "provider_settings_snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Provider Settings Snapshot Hash",
      "type": "string"
    },
    "scene_plan_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Scene Plan Artifact Id",
      "type": "string"
    },
    "schema_version": {
      "const": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "script_analysis_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Script Analysis Artifact Id",
      "type": "string"
    },
    "script_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Script Artifact Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "waiting_for_media",
        "finalizing",
        "completed",
        "partial",
        "failed",
        "superseded",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "style_bible_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Style Bible Artifact Id",
      "type": "string"
    },
    "visual_plan_artifact_id": {
      "pattern": "^artifact_[0-9a-f]{12}$",
      "title": "Visual Plan Artifact Id",
      "type": "string"
    },
    "visual_reference_approval_set_artifact_id": {
      "anyOf": [
        {
          "pattern": "^artifact_[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Visual Reference Approval Set Artifact Id"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "project_id",
    "operation_type",
    "status",
    "script_artifact_id",
    "script_analysis_artifact_id",
    "style_bible_artifact_id",
    "scene_plan_artifact_id",
    "visual_plan_artifact_id",
    "prompt_bundle_artifact_id",
    "visual_reference_approval_set_artifact_id",
    "expected_scene_asset_manifest_artifact_id",
    "media_batch_id",
    "frozen_reference_bindings_hash",
    "provider_settings_snapshot_hash"
  ],
  "title": "SceneAssetOperationIntegrity",
  "type": "object"
}
