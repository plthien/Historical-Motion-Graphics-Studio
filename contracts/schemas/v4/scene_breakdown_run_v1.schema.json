{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_run_v1.schema.json",
  "title": "Scene Breakdown Run V4 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "run_id",
    "operation",
    "project_id",
    "source_script_revision_id",
    "source_script_analysis_revision_id",
    "source_style_bible_revision_id",
    "expected_previous_scene_plan_artifact_id",
    "source_scene_plan_artifact_id",
    "frozen_execution",
    "status",
    "section_results",
    "created_at",
    "expected_previous_visual_plan_artifact_id",
    "source_visual_plan_artifact_id",
    "source_visual_reference_approval_set_artifact_id"
  ],
  "properties": {
    "artifact_type": {
      "const": "scene_breakdown_run"
    },
    "schema_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^(job|import)_[0-9a-f]{12}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "full_generation",
        "section_regeneration",
        "resume_failed_run",
        "full_import"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "source_script_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "source_script_analysis_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "source_style_bible_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "expected_previous_scene_plan_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_scene_plan_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "frozen_execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_type",
            "model",
            "temperature",
            "max_output_tokens",
            "timeout_seconds",
            "max_retries",
            "prompt_version",
            "prompt_sha256",
            "raw_schema_id",
            "raw_schema_sha256"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "provider_type": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "temperature": {
              "type": "number"
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "prompt_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "raw_schema_id": {
              "type": "string",
              "minLength": 1
            },
            "raw_schema_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "authoring_artifact_ids"
          ],
          "properties": {
            "mode": {
              "const": "external_import"
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "prompt_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "raw_schema_id": {
              "type": "string",
              "minLength": 1
            },
            "raw_schema_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "authoring_artifact_ids": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scene_plan",
                "visual_plan"
              ],
              "properties": {
                "scene_plan": {
                  "type": "string",
                  "pattern": "^artifact_[0-9a-f]{12}$",
                  "description": "Reserved Scene Plan Artifact ID used by the external import."
                },
                "visual_plan": {
                  "type": "string",
                  "pattern": "^artifact_[0-9a-f]{12}$",
                  "description": "Reserved Visual Plan Artifact ID used by the external import."
                }
              },
              "description": "Reserved paired Artifact IDs echoed by the external ChatGPT result."
            }
          },
          "description": "External import execution metadata. Reserved Artifact IDs are authoritative; prompt/schema audit fields are optional for compatibility with existing pending reservations."
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed"
      ]
    },
    "section_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section_result"
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "expected_previous_visual_plan_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact Visual Plan pointer frozen at submission."
    },
    "source_visual_plan_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Paired source Visual Plan reused by section regeneration, or null."
    },
    "source_visual_reference_approval_set_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Visual-reference approval set frozen for semantic-to-native binding."
    }
  },
  "$defs": {
    "section_fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "section_order",
        "section_title",
        "section_role",
        "resolved_script_span",
        "pacing_density",
        "scenes",
        "backend_qc"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^sec_[0-9]{3}$"
        },
        "section_order": {
          "type": "integer",
          "minimum": 1
        },
        "section_title": {
          "type": "string",
          "minLength": 1
        },
        "section_role": {
          "type": "string",
          "minLength": 1
        },
        "resolved_script_span": {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/span"
        },
        "pacing_density": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "local_scene_order",
              "resolved_script_span",
              "start_quote",
              "end_quote",
              "beats"
            ],
            "properties": {
              "local_scene_order": {
                "type": "integer",
                "minimum": 1
              },
              "resolved_script_span": {
                "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/span"
              },
              "start_quote": {
                "type": "string",
                "minLength": 1
              },
              "end_quote": {
                "type": "string",
                "minLength": 1
              },
              "beats": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/fragment_beat"
                }
              }
            }
          }
        },
        "backend_qc": {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/backend_qc"
        }
      }
    },
    "fragment_beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_beat_order",
        "script_quote",
        "resolved_script_span",
        "visual_context_ref",
        "word_count",
        "estimated_duration_seconds",
        "narrative_marker_refs",
        "narrative_marker_types",
        "is_narrative_marker",
        "turning_point",
        "reveal",
        "contrast",
        "visual_priority",
        "eligible_character_refs",
        "eligible_location_refs",
        "eligible_prop_refs",
        "eligible_recurring_visual_subject_refs",
        "eligible_motif_refs",
        "pacing_density",
        "visual"
      ],
      "properties": {
        "local_beat_order": {
          "type": "integer",
          "minimum": 1
        },
        "script_quote": {
          "type": "string",
          "minLength": 1
        },
        "resolved_script_span": {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/span"
        },
        "visual_context_ref": {
          "type": "string",
          "pattern": "^ctx_[0-9]{3}$",
          "description": "Canonical Script Analysis visual-context authority for this Beat."
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "narrative_marker_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^marker_[0-9]{3}$"
          }
        },
        "narrative_marker_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "turning_point",
              "reveal",
              "contrast",
              "payoff",
              "emphasis"
            ]
          }
        },
        "is_narrative_marker": {
          "type": "boolean"
        },
        "turning_point": {
          "type": "boolean"
        },
        "reveal": {
          "type": "boolean"
        },
        "contrast": {
          "type": "boolean"
        },
        "visual_priority": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "normal"
          ]
        },
        "eligible_character_refs": {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/char_refs"
        },
        "eligible_location_refs": {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/loc_refs"
        },
        "eligible_prop_refs": {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/prop_refs"
        },
        "eligible_recurring_visual_subject_refs": {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/subject_refs"
        },
        "eligible_motif_refs": {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json#/$defs/motif_refs"
        },
        "pacing_density": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "visual": {
          "description": "Validated beat-specific visual decision from the combined Scene Breakdown call.",
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_section_llm_output_v1.schema.json#/properties/scenes/items/properties/beats/items/properties/visual"
        }
      }
    },
    "section_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "status",
        "normalized_fragment",
        "failure_artifact_id",
        "validation_summary"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "pattern": "^sec_[0-9]{3}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "normalized_fragment": {
          "oneOf": [
            {
              "$ref": "#/$defs/section_fragment"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_artifact_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^artifact_[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical_status",
            "warning_count"
          ],
          "properties": {
            "critical_status": {
              "type": "string",
              "enum": [
                "passed",
                "failed"
              ]
            },
            "warning_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
