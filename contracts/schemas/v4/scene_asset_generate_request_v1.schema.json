{
  "additionalProperties": false,
  "properties": {
    "candidate_count": {
      "default": 1,
      "maximum": 5,
      "minimum": 1,
      "title": "Candidate Count",
      "type": "integer"
    },
    "expected_scene_asset_manifest_artifact_id": {
      "anyOf": [
        {
          "pattern": "^artifact_[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Scene Asset Manifest Artifact Id"
    },
    "operation_type": {
      "default": "generate_all",
      "enum": [
        "generate_all",
        "generate_section",
        "generate_missing",
        "retry_failed",
        "regenerate_section"
      ],
      "title": "Operation Type",
      "type": "string"
    },
    "section_id": {
      "anyOf": [
        {
          "pattern": "^sec_[0-9]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section Id"
    }
  },
  "required": [
    "expected_scene_asset_manifest_artifact_id"
  ],
  "title": "SceneAssetGenerateRequest",
  "type": "object"
}
