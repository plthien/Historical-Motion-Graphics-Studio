{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/schemas/v4/visual_reference_job_submission_response_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "job_type",
    "project_id",
    "operation_id",
    "status",
    "progress"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-f]{12}$"
    },
    "job_type": {
      "const": "visual_reference_v4_generate"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^operation_[0-9a-f]{12}$"
    },
    "status": {
      "const": "queued"
    },
    "progress": {
      "const": 0
    }
  }
}
