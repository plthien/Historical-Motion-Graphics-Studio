{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_read_response_v1.schema.json",
  "title": "Scene Plan Read Response V4 V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "generated",
    "scene_plan_artifact_id",
    "scene_plan",
    "visual_plan_artifact_id",
    "visual_plan"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "generated": {
      "type": "boolean"
    },
    "scene_plan_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scene_plan": {
      "oneOf": [
        {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_plan_v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "visual_plan_artifact_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "visual_plan": {
      "oneOf": [
        {
          "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/visual_plan_v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
