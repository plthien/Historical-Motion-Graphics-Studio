{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/style_bible_input_v1.schema.json",
  "title": "Style Bible Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "script_analysis_artifact_id",
    "source_script_revision_id",
    "continuity_catalog"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "script_analysis_artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "source_script_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "continuity_catalog": {
      "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/script_analysis_v1.schema.json#/properties/continuity_catalog"
    }
  }
}
