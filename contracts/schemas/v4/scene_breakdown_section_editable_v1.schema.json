{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_section_editable_v1.schema.json",
  "title": "Scene Breakdown Editable Section V1",
  "description": "Metadata-editable combined Scene Breakdown section. Scene/Beat topology and Script source ownership are immutable relative to the current paired Scene Plan and Visual Plan drafts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "section_id",
    "scenes"
  ],
  "properties": {
    "section_id": {
      "type": "string",
      "pattern": "^sec_[0-9]{3,}$"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beats"
        ],
        "properties": {
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "script_text",
                "visual"
              ],
              "properties": {
                "script_text": {
                  "type": "string",
                  "minLength": 1,
                  "readOnly": true,
                  "description": "Read-only exact Script source owned by this Beat. Changing source ownership requires rebuilding/repartitioning Step 1."
                },
                "visual": {
                  "description": "Editable beat-specific visual decision. Object keys and array topology remain immutable relative to the current paired draft.",
                  "$ref": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_section_llm_output_v1.schema.json#/properties/scenes/items/properties/beats/items/properties/visual"
                }
              }
            }
          }
        }
      }
    }
  }
}
