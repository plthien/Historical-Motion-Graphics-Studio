{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/schemas/v4/visual_reference_prompt_update_request_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_visual_reference_set_artifact_id",
    "prompt",
    "negative_prompt"
  ],
  "properties": {
    "expected_visual_reference_set_artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000
    },
    "negative_prompt": {
      "type": "string",
      "maxLength": 50000
    }
  }
}
