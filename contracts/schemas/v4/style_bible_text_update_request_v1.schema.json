{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/style_bible_text_update_request_v1.schema.json",
  "title": "Style Bible Text Update Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_style_bible_revision_id",
    "editable_content"
  ],
  "properties": {
    "expected_style_bible_revision_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "editable_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "locations",
        "recurring_props",
        "recurring_visual_subjects",
        "motifs"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "char_id",
              "label",
              "description",
              "explicit_visual_traits",
              "identity_markers",
              "continuity_notes",
              "physical_constraints",
              "entity_kind",
              "narrative_role"
            ],
            "properties": {
              "char_id": {
                "type": "string",
                "pattern": "^char_[0-9]{3}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "explicit_visual_traits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 12
              },
              "identity_markers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 12
              },
              "continuity_notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 10
              },
              "physical_constraints": {
                "$ref": "#/$defs/physical_constraints"
              },
              "entity_kind": {
                "type": "string",
                "enum": [
                  "human_character",
                  "human_group"
                ],
                "description": "Canonical recurring human identity taxonomy: human_character for one recurring individual; human_group for a recurring plural human identity whose continuity matters as a group."
              },
              "narrative_role": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "loc_id",
              "label",
              "description",
              "explicit_visual_traits",
              "identity_markers",
              "continuity_notes",
              "physical_constraints",
              "location_kind"
            ],
            "properties": {
              "loc_id": {
                "type": "string",
                "pattern": "^loc_[0-9]{3}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "explicit_visual_traits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 12
              },
              "identity_markers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 12
              },
              "continuity_notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 10
              },
              "physical_constraints": {
                "$ref": "#/$defs/physical_constraints"
              },
              "location_kind": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "recurring_props": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prop_id",
              "label",
              "description",
              "explicit_visual_traits",
              "identity_markers",
              "continuity_notes",
              "physical_constraints",
              "prop_kind"
            ],
            "properties": {
              "prop_id": {
                "type": "string",
                "pattern": "^prop_[0-9]{3}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "explicit_visual_traits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 12
              },
              "identity_markers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 12
              },
              "continuity_notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 10
              },
              "physical_constraints": {
                "$ref": "#/$defs/physical_constraints"
              },
              "prop_kind": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "recurring_visual_subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject_id",
              "label",
              "description",
              "visual_type",
              "explicit_visual_traits",
              "continuity_notes",
              "physical_constraints"
            ],
            "properties": {
              "subject_id": {
                "type": "string",
                "pattern": "^subject_[0-9]{3}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "visual_type": {
                "type": "string",
                "minLength": 1
              },
              "explicit_visual_traits": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 12
              },
              "continuity_notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "maxItems": 10
              },
              "physical_constraints": {
                "$ref": "#/$defs/physical_constraints"
              }
            }
          }
        },
        "motifs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "motif_id",
              "label",
              "description"
            ],
            "properties": {
              "motif_id": {
                "type": "string",
                "pattern": "^motif_[0-9]{3}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "physical_constraints": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
