{
  "$defs": {
    "RationalFrameRateModel": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "maximum": 240000,
          "minimum": 1,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "maximum": 1001,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalFrameRateModel",
      "type": "object"
    },
    "RenderProfileModel": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Profile Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "width": {
          "maximum": 7680,
          "minimum": 320,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 4320,
          "minimum": 240,
          "title": "Height",
          "type": "integer"
        },
        "frame_rate": {
          "$ref": "#/$defs/RationalFrameRateModel"
        },
        "video_codec": {
          "const": "libx264",
          "title": "Video Codec",
          "type": "string"
        },
        "video_crf": {
          "maximum": 51,
          "minimum": 0,
          "title": "Video Crf",
          "type": "integer"
        },
        "video_preset": {
          "enum": [
            "ultrafast",
            "superfast",
            "veryfast",
            "faster",
            "fast",
            "medium",
            "slow",
            "slower",
            "veryslow"
          ],
          "title": "Video Preset",
          "type": "string"
        },
        "pixel_format": {
          "const": "yuv420p",
          "title": "Pixel Format",
          "type": "string"
        },
        "audio_codec": {
          "const": "aac",
          "title": "Audio Codec",
          "type": "string"
        },
        "audio_bitrate_kbps": {
          "maximum": 512,
          "minimum": 64,
          "title": "Audio Bitrate Kbps",
          "type": "integer"
        },
        "audio_sample_rate_hz": {
          "const": 48000,
          "title": "Audio Sample Rate Hz",
          "type": "integer"
        },
        "audio_channels": {
          "const": 2,
          "title": "Audio Channels",
          "type": "integer"
        },
        "subtitle_mode": {
          "enum": [
            "embedded_mov_text",
            "sidecar_only"
          ],
          "title": "Subtitle Mode",
          "type": "string"
        },
        "faststart": {
          "const": true,
          "title": "Faststart",
          "type": "boolean"
        },
        "deterministic_encoding": {
          "title": "Deterministic Encoding",
          "type": "boolean"
        },
        "encoder_threads": {
          "default": 1,
          "maximum": 16,
          "minimum": 1,
          "title": "Encoder Threads",
          "type": "integer"
        },
        "clipping_policy": {
          "const": "fail_on_detected_clipping",
          "default": "fail_on_detected_clipping",
          "title": "Clipping Policy",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "display_name",
        "enabled",
        "width",
        "height",
        "frame_rate",
        "video_codec",
        "video_crf",
        "video_preset",
        "pixel_format",
        "audio_codec",
        "audio_bitrate_kbps",
        "audio_sample_rate_hz",
        "audio_channels",
        "subtitle_mode",
        "faststart",
        "deterministic_encoding"
      ],
      "title": "RenderProfileModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "compiler_version": {
      "const": "ffmpeg_render_graph_v2",
      "title": "Compiler Version",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/RenderProfileModel"
    },
    "ordered_input_descriptors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 3,
      "title": "Ordered Input Descriptors",
      "type": "array"
    },
    "visual_nodes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Visual Nodes",
      "type": "array"
    },
    "audio_nodes": {
      "additionalProperties": true,
      "title": "Audio Nodes",
      "type": "object"
    },
    "subtitle_mapping": {
      "additionalProperties": true,
      "title": "Subtitle Mapping",
      "type": "object"
    },
    "concat": {
      "additionalProperties": true,
      "title": "Concat",
      "type": "object"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "command_graph_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Command Graph Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "compiler_version",
    "profile",
    "ordered_input_descriptors",
    "visual_nodes",
    "audio_nodes",
    "subtitle_mapping",
    "concat",
    "output",
    "command_graph_sha256"
  ],
  "title": "RenderCommandGraphModel",
  "type": "object"
}