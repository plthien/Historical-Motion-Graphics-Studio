{
  "$defs": {
    "FinalVideoMetadataModel": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "video_codec": {
          "const": "h264",
          "title": "Video Codec",
          "type": "string"
        },
        "pixel_format": {
          "const": "yuv420p",
          "title": "Pixel Format",
          "type": "string"
        },
        "frame_rate": {
          "$ref": "#/$defs/RationalFrameRateModel"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "audio_codec": {
          "const": "aac",
          "title": "Audio Codec",
          "type": "string"
        },
        "audio_sample_rate_hz": {
          "const": 48000,
          "title": "Audio Sample Rate Hz",
          "type": "integer"
        },
        "audio_channels": {
          "const": 2,
          "title": "Audio Channels",
          "type": "integer"
        },
        "subtitle_mode": {
          "enum": [
            "embedded_mov_text",
            "sidecar_only"
          ],
          "title": "Subtitle Mode",
          "type": "string"
        },
        "subtitle_stream_count": {
          "maximum": 1,
          "minimum": 0,
          "title": "Subtitle Stream Count",
          "type": "integer"
        },
        "faststart": {
          "title": "Faststart",
          "type": "boolean"
        },
        "decode_valid": {
          "title": "Decode Valid",
          "type": "boolean"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "width",
        "height",
        "duration_seconds",
        "video_codec",
        "pixel_format",
        "frame_rate",
        "frame_count",
        "audio_codec",
        "audio_sample_rate_hz",
        "audio_channels",
        "subtitle_mode",
        "subtitle_stream_count",
        "faststart",
        "decode_valid"
      ],
      "title": "FinalVideoMetadataModel",
      "type": "object"
    },
    "RationalFrameRateModel": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "maximum": 240000,
          "minimum": 1,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "maximum": 1001,
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalFrameRateModel",
      "type": "object"
    },
    "RenderActiveOperationModel": {
      "additionalProperties": false,
      "properties": {
        "render_operation_id": {
          "title": "Render Operation Id",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "operation_type": {
          "title": "Operation Type",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "title": "Progress",
          "type": "integer"
        },
        "attempt_no": {
          "title": "Attempt No",
          "type": "integer"
        }
      },
      "required": [
        "render_operation_id",
        "job_id",
        "operation_type",
        "status",
        "progress",
        "attempt_no"
      ],
      "title": "RenderActiveOperationModel",
      "type": "object"
    },
    "RenderReadinessIssueModel": {
      "additionalProperties": false,
      "properties": {
        "error_code": {
          "title": "Error Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        }
      },
      "required": [
        "error_code",
        "message"
      ],
      "title": "RenderReadinessIssueModel",
      "type": "object"
    },
    "RenderReadinessModel": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "not_ready",
            "disabled"
          ],
          "title": "Status",
          "type": "string"
        },
        "profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Id"
        },
        "ffmpeg_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffmpeg Version"
        },
        "ffprobe_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ffprobe Version"
        },
        "capabilities_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capabilities Sha256"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/RenderReadinessIssueModel"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "status",
        "issues"
      ],
      "title": "RenderReadinessModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "readiness": {
      "$ref": "#/$defs/RenderReadinessModel"
    },
    "current_assembly_plan_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Assembly Plan Artifact Id"
    },
    "current_subtitle_srt_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Subtitle Srt Artifact Id"
    },
    "current_subtitle_vtt_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Subtitle Vtt Artifact Id"
    },
    "selected_render_profile_id": {
      "title": "Selected Render Profile Id",
      "type": "string"
    },
    "active_operation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RenderActiveOperationModel"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_final_video_artifact_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Final Video Artifact Id"
    },
    "video_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Video Url"
    },
    "vtt_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Vtt Url"
    },
    "final_video": {
      "anyOf": [
        {
          "$ref": "#/$defs/FinalVideoMetadataModel"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation_summary": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Validation Summary"
    },
    "available_actions": {
      "items": {
        "type": "string"
      },
      "title": "Available Actions",
      "type": "array"
    },
    "errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "readiness",
    "current_assembly_plan_artifact_id",
    "current_subtitle_srt_artifact_id",
    "current_subtitle_vtt_artifact_id",
    "selected_render_profile_id",
    "active_operation",
    "current_final_video_artifact_id",
    "video_url",
    "vtt_url",
    "final_video",
    "validation_summary",
    "available_actions",
    "errors"
  ],
  "title": "RenderWorkspaceResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/v4/render_workspace_response_v1.schema.json"
}
