{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/script_analysis_llm_output_v1.schema.json",
  "title": "Script Analysis LLM Output V1",
  "description": "Strict provider output containing only section pacing guidance, production-relevant narrative markers, and recurring visual continuity candidates. Every quote-bearing item copies an existing section_id and supplies exact quote context for deterministic resolution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "project_id",
    "source_script_revision_id",
    "section_guidance",
    "narrative_markers",
    "continuity_catalog",
    "visual_context_catalog"
  ],
  "properties": {
    "artifact_type": {
      "const": "script_analysis_llm_output"
    },
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "$ref": "#/$defs/project_id"
    },
    "source_script_revision_id": {
      "$ref": "#/$defs/artifact_id"
    },
    "section_guidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section_guidance_raw"
      }
    },
    "narrative_markers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/narrative_marker_raw"
      }
    },
    "continuity_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "locations",
        "recurring_props",
        "recurring_visual_subjects",
        "visual_motifs"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/character_raw"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location_raw"
          }
        },
        "recurring_props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prop_raw"
          }
        },
        "recurring_visual_subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recurring_visual_subject_raw"
          }
        },
        "visual_motifs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visual_motif_raw"
          }
        }
      }
    },
    "visual_context_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/visual_context_raw"
      }
    }
  },
  "$defs": {
    "project_id": {
      "type": "string",
      "pattern": "^project_[0-9a-f]{12}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "section_id": {
      "type": "string",
      "pattern": "^sec_[0-9]{3}$"
    },
    "occurrence_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "quote",
        "context_quote"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/section_id"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "context_quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "section_guidance_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "pacing_density"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/section_id"
        },
        "pacing_density": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "narrative_marker_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marker_type",
        "section_id",
        "anchor_quote",
        "context_quote",
        "importance",
        "purpose"
      ],
      "properties": {
        "marker_type": {
          "type": "string",
          "enum": [
            "turning_point",
            "reveal",
            "contrast",
            "payoff",
            "emphasis"
          ]
        },
        "section_id": {
          "$ref": "#/$defs/section_id"
        },
        "anchor_quote": {
          "type": "string",
          "minLength": 1
        },
        "context_quote": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "character_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "entity_kind",
        "narrative_role",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/occurrence_raw"
          }
        },
        "entity_kind": {
          "type": "string",
          "enum": [
            "human_character",
            "human_group"
          ],
          "description": "Canonical recurring human identity taxonomy: human_character for one recurring individual; human_group for a recurring plural human identity whose continuity matters as a group."
        },
        "narrative_role": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_raw"
          },
          "description": "Ordered authoritative ranges where this same canonical entity is narratively active. Occurrences are direct anchors; these ranges define downstream eligibility scope."
        }
      }
    },
    "location_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "location_kind",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/occurrence_raw"
          }
        },
        "location_kind": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_raw"
          },
          "description": "Ordered authoritative ranges where this same canonical entity is narratively active. Occurrences are direct anchors; these ranges define downstream eligibility scope."
        }
      }
    },
    "prop_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "explicit_visual_traits",
        "identity_markers",
        "continuity_notes",
        "physical_constraints",
        "prop_kind",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "identity_markers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/occurrence_raw"
          }
        },
        "prop_kind": {
          "type": "string",
          "minLength": 1
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_raw"
          },
          "description": "Ordered authoritative ranges where this same canonical entity is narratively active. Occurrences are direct anchors; these ranges define downstream eligibility scope."
        }
      }
    },
    "recurring_visual_subject_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "visual_type",
        "explicit_visual_traits",
        "continuity_notes",
        "physical_constraints",
        "occurrences",
        "presence_ranges"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "visual_type": {
          "type": "string",
          "minLength": 1
        },
        "explicit_visual_traits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "continuity_notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 10
        },
        "physical_constraints": {
          "$ref": "#/$defs/physical_constraints"
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/occurrence_raw"
          }
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_raw"
          },
          "description": "Ordered authoritative ranges where this same canonical entity is narratively active. Occurrences are direct anchors; these ranges define downstream eligibility scope."
        }
      }
    },
    "visual_motif_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "occurrences"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/occurrence_raw"
          }
        }
      }
    },
    "physical_constraints": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "description": "Stable physical facts that downstream visuals must preserve; never include transient staging, camera, lighting, or mood instructions."
    },
    "visual_context_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "mode",
        "timeframe",
        "setting",
        "constraints",
        "presence_ranges"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mode": {
          "type": "string",
          "enum": [
            "story_world",
            "representative_scenario",
            "evidence_view",
            "reconstruction",
            "neutral_abstract",
            "mixed_context"
          ]
        },
        "timeframe": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200
        },
        "setting": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 300
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "presence_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/presence_range_raw"
          }
        }
      }
    },
    "presence_range_raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "start_quote",
        "end_quote"
      ],
      "properties": {
        "section_id": {
          "$ref": "#/$defs/section_id"
        },
        "start_quote": {
          "type": "string",
          "minLength": 1,
          "description": "Exact unique quote from the declared Script section marking where this canonical entity becomes narratively active."
        },
        "end_quote": {
          "type": "string",
          "minLength": 1,
          "description": "Exact unique quote from the same Script section marking the last text where this canonical entity remains narratively active."
        }
      },
      "description": "Authoritative narrative scope for one canonical continuity entity. The range may contain pronouns or implicit continuation and must stop before generic, comparative, evidentiary, or different-identity material."
    }
  }
}
