{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/schemas/v4/scene_breakdown_section_edit_save_request_v1.schema.json",
  "title": "Scene Breakdown Section Edit Save Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_scene_plan_artifact_id",
    "validation_artifact_id",
    "section",
    "expected_visual_plan_artifact_id"
  ],
  "properties": {
    "expected_scene_plan_artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "validation_artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$"
    },
    "section": {
      "type": "object"
    },
    "expected_visual_plan_artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-f]{12}$",
      "description": "Exact current Visual Plan artifact paired with the expected Scene Plan."
    }
  }
}
