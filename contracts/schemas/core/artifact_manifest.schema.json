{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/v2.2.1/schemas/core/artifact_manifest.schema.json",
  "title": "ArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "project_id",
    "logical_id",
    "version_no",
    "is_current",
    "artifact_type",
    "path",
    "status",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "logical_id": {
      "type": "string"
    },
    "version_no": {
      "type": "integer",
      "minimum": 1
    },
    "is_current": {
      "type": "boolean"
    },
    "superseded_by_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "srt",
        "vtt",
        "json",
        "thumbnail",
        "export_zip"
      ]
    },
    "path": {
      "type": "string"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_plan_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "creating",
        "ready",
        "failed",
        "deleted"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "deleted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "artifact_role": {
      "type": "string",
      "enum": [
        "scene_image",
        "voice_audio",
        "subtitle_srt",
        "subtitle_vtt",
        "thumbnail_image",
        "final_video",
        "preview_video",
        "metadata_file",
        "export_zip",
        "manifest_json",
        "plan_json"
      ]
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "size_bytes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "width": {
      "type": [
        "integer",
        "null"
      ]
    },
    "height": {
      "type": [
        "integer",
        "null"
      ]
    },
    "duration_sec": {
      "type": [
        "number",
        "null"
      ]
    },
    "provider_result_url": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "x-contract-version": "2.2.1"
}
