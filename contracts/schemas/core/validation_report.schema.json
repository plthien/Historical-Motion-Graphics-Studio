{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtube-ai-studio.local/contracts/v2.2.1/schemas/core/validation_report.schema.json",
  "title": "ValidationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "errors",
    "warnings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "not_validated",
        "passed",
        "failed"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      }
    }
  },
  "$defs": {
    "ValidationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "x-contract-version": "2.2.1"
}
